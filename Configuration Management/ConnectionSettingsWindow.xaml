<Window x:Class="Configuration_Management.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Configuration_Management.Models"
        mc:Ignorable="d"
        Title="Настройки подключения"
        Icon="{StaticResource AppIcon}"
        Width="540"
        MinHeight="580" MinWidth="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                            <Border Grid.Row="0" Background="{TemplateBinding Background}"
                                    Padding="12,8,12,0" Margin="8,0,0,0" HorizontalAlignment="Left">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.FontSize="13"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 1. Параметры подключения (вверху, как в классическом 1С) ============ -->
        <GroupBox Grid.Row="0" Header="Параметры подключения">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center" Margin="0,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" Padding="8,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Группа:" VerticalAlignment="Center" Margin="0,4"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsReadOnly="True"
                             Text="{Binding GroupDisplayPath, Mode=OneWay}"
                             Padding="4,3" VerticalContentAlignment="Center"
                             ToolTip="Группа информационной базы"/>
                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,4"
                            Style="{DynamicResource SecondaryButton}"
                            Click="OnSelectGroup_Click" ToolTip="Выбрать группу в дереве">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Выбрать…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание:" VerticalAlignment="Center" Margin="0,6"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" Padding="8,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Тип подключения:" VerticalAlignment="Top" Margin="0,6"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
                    <RadioButton Content="На сервере 1С:Предприятия" Margin="0,2"
                                 IsChecked="{Binding IsClientServer, UpdateSourceTrigger=PropertyChanged}"/>
                    <RadioButton Content="В файловой информационной базе" Margin="0,2"
                                 IsChecked="{Binding IsFile, UpdateSourceTrigger=PropertyChanged}"/>
                    <RadioButton Content="На веб-сервере" Margin="0,2"
                                 IsChecked="{Binding IsWebServer, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Клиент-серверные поля -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Сервер:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Имя базы:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Порт сервера:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>

                <!-- Файловые поля -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Путь к файлу:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"/>

                <!-- Веб-сервер -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="URL публикации:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsWebServer, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WebUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsWebServer, Converter={StaticResource BoolToVis}}"
                         ToolTip="Адрес веб-публикации, например http://server/base"/>

                <!-- Аутентификация (как в стандартном лаунчере 1С) -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Аутентификация:" VerticalAlignment="Top" Margin="0,6"/>
                <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,2">
                    <RadioButton Content="Запрашивать имя и пароль" Margin="0,2"
                                 IsChecked="{Binding IsAuthPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="При запуске платформа запросит имя пользователя и пароль"/>
                    <RadioButton Content="Выполнять вход в систему автоматически" Margin="0,2"
                                 IsChecked="{Binding IsAuthCredentials, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Вход по сохранённым логину и паролю без запроса"/>
                    <RadioButton Content="Аутентификация операционной системы" Margin="0,2"
                                 IsChecked="{Binding IsAuthWindows, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Вход под учётной записью Windows (аутентификация ОС)"/>
                </StackPanel>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Пользователь:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"
                         ToolTip="Имя пользователя 1С для автоматического входа"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Пароль:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"
                         ToolTip="Пароль пользователя 1С для автоматического входа"/>
            </Grid>
        </GroupBox>

        <!-- ============ 2. Режим запуска ============ -->
        <GroupBox Grid.Row="1" Header="Режим запуска">
            <StackPanel>
                <RadioButton Content="Автоматический" IsChecked="{Binding IsAutoMode, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <RadioButton Content="Тонкий клиент" IsChecked="{Binding IsThinClient, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <RadioButton Content="Толстый клиент" IsChecked="{Binding IsThickClient, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <RadioButton Content="Веб-клиент" IsChecked="{Binding IsWebClient, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsWebClientAllowed}" Margin="0,2"
                             ToolTip="Доступен только при подключении через веб-сервер или клиент-сервер"/>
            </StackPanel>
        </GroupBox>

        <!-- ============ 3. Разрядность и версия платформы ============ -->
        <GroupBox Grid.Row="2" Header="Разрядность и версия платформы">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Разрядность:" VerticalAlignment="Top" Margin="0,6"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                    <RadioButton Content="32-битная" IsChecked="{Binding IsArchitecture32, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                    <RadioButton Content="64-битная" IsChecked="{Binding IsArchitecture64, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Версия платформы:" VerticalAlignment="Center" Margin="0,4"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding PlatformVersion, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" VerticalContentAlignment="Center"
                             ToolTip="Введите версию платформы вручную (например, 8.3.24.1774)"/>
                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,3"
                            Style="{DynamicResource SecondaryButton}" Click="OnPlatformSettings_Click"
                            ToolTip="Выбрать версию платформы из установленных">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Параметры запуска:" VerticalAlignment="Center" Margin="0,4"/>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding LaunchParameters, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" VerticalContentAlignment="Center"
                             ToolTip="Дополнительные параметры командной строки 1С (например, /UC, /DisableStartupMessages)"/>
                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,3"
                            Style="{DynamicResource SecondaryButton}" Click="OnLaunchParameters_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Конфигуратор" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ============ ID базы ============ -->
        <GroupBox Grid.Row="3" Header="Идентификатор">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ID базы:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Column="1" Text="{Binding Id}" Padding="4,3" Margin="0,4"
                         IsReadOnly="True" ToolTip="Уникальный идентификатор базы данных"/>
                <Button Grid.Column="2" Margin="6,0,0,0" Padding="8,3"
                        Style="{DynamicResource SecondaryButton}" Click="OnCopyId_Click"
                        ToolTip="Скопировать ID базы в буфер обмена">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
            </Grid>
        </GroupBox>

        <!-- ============ Кнопки ============ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Width="130" Height="36" Style="{DynamicResource ModernButton}"
                    Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click"
                    IsEnabled="{Binding HasChanges}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSave}" Fill="White" Width="16" Height="16"
                          Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="36" Style="{DynamicResource SecondaryButton}" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconClear}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14"
                          Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
        </ScrollViewer>

        <!-- ============ Кнопки (как в настройках программы) ============ -->
        <Border Grid.Row="2" Padding="16,12"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="140" Height="36" Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click"
                        IsEnabled="{Binding HasChanges}"
                        Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#166534"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Сохранить" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Width="140" Height="36" IsCancel="True" Click="OnCancel_Click"
                        Background="Transparent" Cursor="Hand" BorderThickness="1.5"
                        BorderBrush="#EF4444" Foreground="#EF4444">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Отмена" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
