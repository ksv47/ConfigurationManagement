<Window x:Class="Configuration_Management.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Configuration_Management.Models"
        mc:Ignorable="d"
        Title="Настройки подключения"
        Icon="{StaticResource AppIcon}"
        Width="760"
        MinHeight="600" MinWidth="680"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                            <Border Grid.Row="0" Background="{TemplateBinding Background}"
                                    Padding="10,4,10,0" Margin="8,0,0,0" HorizontalAlignment="Left">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.FontSize="13"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Вертикальные вкладки окна подключения (слева), как в окне «Настройки» -->
        <Style x:Key="ConnTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="0,4,8,12" Background="Transparent"
                                    ClipToBounds="False">
                                <StackPanel IsItemsHost="True" ClipToBounds="False"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="SelectedContent"
                                              Margin="8,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,3,0"
                                CornerRadius="8"
                                Width="{TemplateBinding Width}"
                                MinHeight="40"
                                SnapsToDevicePixels="True"
                                ClipToBounds="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Padding="20,16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0"
                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Database" Width="22" Height="22"
                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Настройки подключения" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Параметры информационной базы 1С:Предприятие"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Контент: вкладки -->
        <TabControl Grid.Row="1" Margin="12,8,12,4" Style="{StaticResource ConnTabControl}">
            <!-- База -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Database" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="База" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Database" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Информационная база" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Группа:" VerticalAlignment="Center" Margin="0,3"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding GroupDisplayPath, Mode=OneWay}" Padding="8,6" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,4" Style="{DynamicResource SecondaryButton}" Click="OnSelectGroup_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Выбрать…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание:" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4"/>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- Подключение -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LanConnect" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Подключение" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ServerNetwork" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Тип и параметры подключения" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип:" VerticalAlignment="Top" Margin="0,4"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0">
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClientServer}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton GroupName="ConnType" Cursor="Hand"
                                             IsChecked="{Binding IsClientServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <StackPanel>
                                        <TextBlock Text="Сервер 1С:Предприятия" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Клиент-серверный вариант (Srvr / Ref)." FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton GroupName="ConnType" Cursor="Hand"
                                             IsChecked="{Binding IsFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <StackPanel>
                                        <TextBlock Text="Файловая база" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Каталог информационной базы на диске (File)." FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWebServer}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton GroupName="ConnType" Cursor="Hand"
                                             IsChecked="{Binding IsWebServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <StackPanel>
                                        <TextBlock Text="Веб-сервер" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Публикация на веб-сервере (WS)." FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Сервер:" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <!-- Стиль ModernComboBox переопределяет шаблон без PART_EditableTextBox и не поддерживает
                             редактируемый режим, поэтому для поля сервера отключаем его (Style={x:Null}),
                             чтобы можно было и выбрать сервер из списка, и ввести его вручную. -->
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" Padding="6,4"
                                  Style="{x:Null}"
                                  IsEditable="True"
                                  ItemsSource="{Binding AvailableServers}"
                                  Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Имя сервера 1С. Можно выбрать из существующих баз или ввести вручную."
                                  Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Имя базы:" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4" Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Порт сервера:" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <!-- Стиль ModernComboBox переопределяет шаблон без PART_EditableTextBox и не поддерживает
                             редактируемый режим, поэтому для поля порта отключаем его (Style={x:Null}),
                             чтобы можно было и выбрать порт из списка, и ввести его вручную. -->
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" Padding="6,4"
                                  Style="{x:Null}"
                                  IsEditable="True"
                                  ItemsSource="{Binding AvailablePorts}"
                                  Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Порт сервера 1С. Можно выбрать из портов существующих баз или ввести вручную."
                                  Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Путь к файлу:" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4" Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="URL публикации:" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsWebServer, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WebUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4" Visibility="{Binding IsWebServer, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- Аутентификация -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountKey" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Аутентификация" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountKey" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Аутентификация" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Режим:" VerticalAlignment="Top" Margin="0,4"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0">
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAuthPrompt}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton GroupName="AuthMode" Cursor="Hand"
                                             IsChecked="{Binding IsAuthPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <StackPanel>
                                        <TextBlock Text="Запрашивать имя и пароль" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Платформа покажет диалог входа при запуске." FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAuthCredentials}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton GroupName="AuthMode" Cursor="Hand"
                                             IsChecked="{Binding IsAuthCredentials, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <StackPanel>
                                        <TextBlock Text="Вход автоматически" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Сохранённые пользователь и пароль без запроса." FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAuthWindows}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton GroupName="AuthMode" Cursor="Hand"
                                             IsChecked="{Binding IsAuthWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <StackPanel>
                                        <TextBlock Text="Аутентификация ОС" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Вход под учётной записью Windows." FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Пользователь:" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4" Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Пароль:" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4" Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- Запуск -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Запуск" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ApplicationOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Режим запуска клиента" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>
                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoMode}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="LaunchMode" Cursor="Hand"
                                     IsChecked="{Binding IsAutoMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="Автоматический" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Режим выбирает платформа 1С по настройкам информационной базы (как в стандартном списке баз)." FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThinClient}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="LaunchMode" Cursor="Hand"
                                     IsChecked="{Binding IsThinClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="Тонкий клиент" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Управляемое приложение (1cv8c). Меньше ресурсов, типичный режим для пользователей." FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThickClient}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="LaunchMode" Cursor="Hand"
                                     IsChecked="{Binding IsThickClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="Толстый клиент" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Полный клиент 1cv8. Нужен для конфигуратора, отладки и ряда режимов совместимости." FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            IsEnabled="{Binding IsWebClientAllowed}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWebClient}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="LaunchMode" Cursor="Hand"
                                     IsEnabled="{Binding IsWebClientAllowed}"
                                     IsChecked="{Binding IsWebClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="Веб-клиент" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Открытие в браузере. Нужна веб-публикация базы на сервере." FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <TextBlock Text="{Binding LaunchModeHint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,6,0,0"/>
                    </StackPanel>
                </GroupBox>
            </TabItem>

            <!-- Разрядность -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Chip" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Разрядность" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Chip" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Разрядность клиента" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>
                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchitecture32Priority}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="Arch" Cursor="Hand"
                                     IsChecked="{Binding IsArchitecture32Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="Приоритет 32 (x86)" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="По умолчанию в 1С. Предпочтение 32-битному; более новая 64-битная версия побеждает." FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchitecture64Priority}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="Arch" Cursor="Hand"
                                     IsChecked="{Binding IsArchitecture64Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="Приоритет 64 (x86-64)" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Предпочтение 64-битному клиенту (больше памяти). Более новая 32-битная версия побеждает." FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchitecture32}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="Arch" Cursor="Hand"
                                     IsChecked="{Binding IsArchitecture32, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="Только 32 (x86)" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Всегда 32-разрядный клиент. 64-битные установки игнорируются." FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            IsEnabled="{Binding IsOs64Bit}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchitecture64}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="Arch" Cursor="Hand"
                                     IsEnabled="{Binding IsOs64Bit}"
                                     IsChecked="{Binding IsArchitecture64, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="Только 64 (x86-64)" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Всегда 64-разрядный клиент. Нужна 64-битная Windows." FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <TextBlock Text="{Binding ArchitectureHint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,6,0,0"/>
                    <TextBlock FontSize="11" Margin="2,2,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Text" Value="ОС: 64-разрядная Windows — доступны все варианты."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOs64Bit}" Value="False">
                                        <Setter Property="Text" Value="ОС: 32-разрядная Windows — доступен только 32-битный клиент."/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </StackPanel>
                </GroupBox>
            </TabItem>

            <!-- Платформа -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CubeOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Платформа" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CubeOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Версия платформы и параметры" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Версия:" VerticalAlignment="Center" Margin="0,3"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PlatformVersion, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center" ToolTip="Например 8.3.24.1774"/>
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,3" Style="{DynamicResource SecondaryButton}" Click="OnPlatformSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CubeOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Выбрать…" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Параметры:" VerticalAlignment="Center" Margin="0,3"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding LaunchParameters, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,3" Style="{DynamicResource SecondaryButton}" Click="OnLaunchParameters_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Tune" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Параметры" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- Идентификатор -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Identifier" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Идентификатор" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="8,12,8,8" VerticalAlignment="Top">
                    <TextBlock Text="ID информационной базы (из ibases.v8i или сгенерированный)."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="ID" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" MinHeight="28" FontSize="12"
                             VerticalContentAlignment="Center"
                             ToolTip="Идентификатор базы 1С"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Padding="10,5" Margin="0,0,8,0" Style="{DynamicResource SecondaryButton}"
                                Click="OnGenerateId_Click" ToolTip="Создать новый уникальный ID">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Foreground="#22C55E"/>
                                <TextBlock Text="Сгенерировать" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Padding="10,5" Style="{DynamicResource SecondaryButton}"
                                Click="OnCopyId_Click" ToolTip="Копировать ID в буфер обмена">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Копировать" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="16,12"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка вставки строки подключения: всегда доступна слева внизу -->
                <Button Grid.Column="0" Height="36" Padding="12,0" Margin="0,0,10,0"
                        Style="{DynamicResource SecondaryButton}"
                        Click="OnPasteConnectionString_Click"
                        ToolTip="Вставить строку подключения из буфера обмена с разбивкой по полям">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentPaste" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Вставить строку подключения" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="140" Height="36" Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click"
                        IsEnabled="{Binding HasChanges}"
                        Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#166534"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Сохранить" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Width="140" Height="36" IsCancel="True" Click="OnCancel_Click"
                        Background="Transparent" Cursor="Hand" BorderThickness="1.5"
                        BorderBrush="#EF4444" Foreground="#EF4444">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Отмена" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
