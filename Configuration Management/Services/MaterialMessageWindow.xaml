<Window x:Class="Configuration_Management.Services.MaterialMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        Title="{loc:Loc Common.Information}"
        Icon="{StaticResource AppIcon}"
        SizeToContent="WidthAndHeight"
        Width="440"
        MaxWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Border Padding="0" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Иконка типа сообщения -->
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                    Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ItemHoverBrush}">
                <materialDesign:PackIcon x:Name="MessageIcon" Kind="InformationOutline"
                                         Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Текст сообщения -->
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MessageText"
                       TextWrapping="Wrap" FontSize="13" VerticalAlignment="Top"/>

            <!-- Кнопки: «Да» (подтверждение) слева, «Нет» (отмена) справа -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="OkButton" MinWidth="100" Height="34" IsDefault="True"
                        Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White"
                        Margin="0,0,10,0"
                        Click="OnOkClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Тёмная полупрозрачная подсветка в состоянии по умолчанию не перекрывает фон кнопки.
                                     Только явные состояния наведения/нажатия меняют оттенок зелёного. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#166534"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- Явный белый жирный текст гарантирует читаемость на зелёном фоне -->
                    <TextBlock x:Name="OkText" Text="{loc:Loc Common.Ok}" VerticalAlignment="Center"
                               Foreground="White" FontWeight="Bold" FontSize="13"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                </Button>
                <Button x:Name="CancelButton" MinWidth="90" Height="34"
                        Background="Transparent" BorderThickness="1.5"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        Cursor="Hand" Visibility="Collapsed"
                        Click="OnCancelClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="14,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="CancelText" Text="{loc:Loc Common.No}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>