<Window x:Class="Configuration_Management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Configuration_Management"
        xmlns:vm="clr-namespace:Configuration_Management.ViewModels"
        xmlns:models="clr-namespace:Configuration_Management.Models"
        xmlns:conv="clr-namespace:Configuration_Management.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Управление конфигурациями 1С"
        Icon="{StaticResource AppIcon}"
        Height="760" Width="1200"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="OnWindowLoaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!-- Горячие клавиши F3/F4 (и настраиваемые) регистрируются в code-behind RegisterLaunchHotkeys -->
    <Window.InputBindings>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLength"/>
        <conv:GroupColorConverter x:Key="GroupColorConverter"/>
        <conv:GroupTextColorConverter x:Key="GroupTextColorConverter"/>
        <conv:BooleanToGridLengthConverter x:Key="BoolToGridLen"/>
        <conv:ColumnVisibilityConverter x:Key="ColumnVis"/>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter"/>

        <!-- ScrollViewer списка баз: корректные PART_* и привязки полос прокрутки.
             Виртуализация TreeView отключена — иначе высота контента = viewport и ScrollableHeight=0. -->
        <Style x:Key="CardScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CanContentScroll" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="PanningMode" Value="Both"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0" Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="1"
                                       Orientation="Vertical"
                                       Cursor="Arrow"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Cursor="Arrow"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            <Border Grid.Row="1" Grid.Column="1"
                                    Background="{DynamicResource CardBackgroundBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Верхняя панель: кнопки групп | поиск | вкладки | действия ===== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Развернуть / свернуть / группировка — слева от поиска -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ToggleButton IsChecked="{Binding GroupByGroup}"
                                  Click="OnGroupByToggle_Click"
                                  Style="{DynamicResource FilterToggleButton}"
                                  Margin="0,0,6,0"
                                  ToolTip="Группировать базы по группам">
                        <TextBlock Text="{Binding GroupByGroupText}" FontSize="12"/>
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowExpandCollapseButtons, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding ExpandAllGroupsCommand}"
                                Style="{DynamicResource SecondaryButton}" Padding="8,6" Margin="0,0,4,0"
                                ToolTip="Развернуть все группы">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="UnfoldMoreHorizontal" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Развернуть" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CollapseAllGroupsCommand}"
                                Style="{DynamicResource SecondaryButton}" Padding="8,6"
                                ToolTip="Свернуть все группы">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="UnfoldLessHorizontal" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Свернуть" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Поиск + выбранные теги -->
                <Border Grid.Column="1" Margin="0,0,12,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                        CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Margin="2,0,6,0"
                                   VerticalAlignment="Center" Opacity="0.7" IsHitTestVisible="False"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ActiveTagFilters}"
                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                      Visibility="{Binding HasActiveTagFilter, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="6"
                                            Padding="5,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextOnAccentBrush}"/>
                                            <Button Margin="3,0,0,0" Padding="0" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0"
                                                    Command="{Binding DataContext.SearchByTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="Убрать тег">
                                                <materialDesign:PackIcon Kind="Close" Width="10" Height="10"
                                                                         Foreground="{DynamicResource TextOnAccentBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Grid.Column="2" Background="Transparent" BorderThickness="0"
                                 Padding="2,6" FontSize="13" VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по базам, конфигурациям, серверу…"/>
                        <Button Grid.Column="3" Command="{Binding ClearSearchCommand}"
                                Background="Transparent" BorderThickness="0" Padding="6,0" Cursor="Hand"
                                ToolTip="Очистить поиск и все теги" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Вкладки Все / Избранное / Недавние -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <RadioButton Content="Все базы" GroupName="ListMode"
                                 IsChecked="{Binding IsListModeAll, Mode=TwoWay}"
                                 Style="{DynamicResource SegmentRadioButton}" Margin="0,0,4,0"/>
                    <RadioButton Content="Избранное" GroupName="ListMode"
                                 IsChecked="{Binding IsListModeFavorites, Mode=TwoWay}"
                                 Style="{DynamicResource SegmentRadioButton}" Margin="0,0,4,0"/>
                    <RadioButton Content="Недавние" GroupName="ListMode"
                                 IsChecked="{Binding IsListModeRecent, Mode=TwoWay}"
                                 Style="{DynamicResource SegmentRadioButton}"/>
                </StackPanel>

                <!-- Синхронизация + тема + настройки -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ImportFromIbasesV8iCommand}" Style="{DynamicResource SecondaryButton}"
                            Margin="0,0,6,0" Padding="8,6" ToolTip="Загрузить базы из ibases.v8i">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#22C55E"/>
                            <TextBlock Text="Из ibases" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportToIbasesV8iCommand}" Style="{DynamicResource SecondaryButton}"
                            Margin="0,0,8,0" Padding="8,6" ToolTip="Выгрузить базы в ibases.v8i">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Upload" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#3B82F6"/>
                            <TextBlock Text="В ibases" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ThemeToggleButton" Click="OnToggleTheme_Click"
                            Style="{DynamicResource IconButton}" Margin="0,0,4,0" ToolTip="Переключить тему">
                        <materialDesign:PackIcon Kind="WeatherNight" Width="18" Height="18" Foreground="#8B5CF6"/>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}" Style="{DynamicResource IconButton}"
                            ToolTip="Настройки приложения">
                        <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Основная область ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Левая панель: список информационных баз ============ -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,1,0">
                <Grid Margin="12" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <!-- 0: заголовок, 1: фильтры, 2: поиск, 3: теги, 4: список (*) — обязателен *,
                             иначе TreeView меряется по полной высоте контента, ScrollableHeight=0
                             и полосы/колесо не появляются (в т.ч. при сжатии окна). -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Кнопки групп перенесены в верхнюю панель -->
                    <Border Grid.Row="0" Height="0"/>
                    <Border Grid.Row="1" Height="0"/>
                    <Border Grid.Row="2" Height="0"/>

                    <!-- Панель быстрого отбора по тегам -->
                    <Border Grid.Row="3" Margin="4,0,4,8" Padding="8,6"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding ShowTagFilterPanel, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Теги — нажмите, чтобы добавить в фильтр поиска" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding TagFilterItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,4" Padding="7,2" Cursor="Hand"
                                                Command="{Binding DataContext.SearchByTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Name}"
                                                ToolTip="{Binding Name, StringFormat=Отбор по тегу: {0}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Tag" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Область списка: общий горизонтальный ScrollViewer, чтобы заголовки колонок
                         прокручивались синхронно с содержимым дерева -->
                    <!-- Внешний ScrollViewer управляет прокруткой по обеим осям. Прокрутка дерева
                         вынесена сюда (а не на внутренний ScrollViewer TreeView), чтобы избежать
                         циклической привязки высоты, из-за которой полоса прокрутки пропадала при
                         сжатии окна. Контент (заголовки + дерево) прокручивается синхронно
                         по горизонтали и вертикали. -->
                    <Grid Grid.Row="4" Margin="4,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Фиксированный заголовок таблицы: прокручивается только горизонтально,
                             синхронно со списком баз. При вертикальной прокрутке остаётся на месте. -->
                        <ScrollViewer x:Name="DbHeaderScroll" Grid.Row="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnDbHeader_PreviewMouseWheel">
                            <!-- Правый отступ компенсирует ширину вертикальной полосы прокрутки списка,
                                 чтобы правый край колонки (*) заголовка совпадал с данными. -->
                            <Border BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1"
                                    Padding="0,2,0,2" Opacity="0.95">
                            <Grid x:Name="HeaderGrid" MinWidth="{Binding ActualWidth, ElementName=MainTree}">
                                <Grid.ColumnDefinitions>
                                    <!-- Первая колонка компенсирует сдвиг строк данных внутри TreeView,
                                         чтобы заголовки колонок и границы разделителей совпадали с данными.
                                         Фактическое значение устанавливается программно (OnWindowLoaded)
                                         по измеренному сдвигу первой видимой строки базы, поэтому колонки
                                         совпадают и при группировке, и без неё. -->
                                    <ColumnDefinition x:Name="HeaderOffsetColumn" Width="70"/>
                                    <ColumnDefinition Width="{Binding DataContext.ShowFavoritesButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=26}"/>
                                    <ColumnDefinition Width="{Binding DataContext.ShowPinnedButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=26}"/>
                                    <ColumnDefinition x:Name="NameColumn" Width="250"/>
                                    <ColumnDefinition x:Name="VersionColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="120">
                                                <Binding Path="DataContext.ShowVersionColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.VersionColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition x:Name="LaunchModeColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="120">
                                                <Binding Path="DataContext.ShowLaunchModeColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.LaunchModeColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition x:Name="ServerColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="200">
                                                <Binding Path="DataContext.ShowServerColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.ServerColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition x:Name="LastLaunchColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="140">
                                                <Binding Path="DataContext.ShowLastLaunchColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.LastLaunchColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="3" Text="Название" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" Margin="0,0,8,4"
                                           Cursor="Hand" Tag="Name" ToolTip="Сортировка по наименованию (клик)"
                                           MouseLeftButtonUp="OnColumnHeader_Click"/>
                                <TextBlock Grid.Column="4" Text="Версия платформы" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" Margin="6,0,6,4"/>
                                <TextBlock Grid.Column="5" Text="Режим запуска" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" Margin="6,0,6,4"/>
                                <TextBlock Grid.Column="6" Text="Сервер/База" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" Margin="6,0,6,4"/>
                                <TextBlock Grid.Column="7" Text="Последний запуск" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" Margin="6,0,6,4"
                                           Cursor="Hand" Tag="LastLaunchDate" ToolTip="Сортировка по дате последнего запуска (клик)"
                                           MouseLeftButtonUp="OnColumnHeader_Click"/>

                                <!-- Современные разделители колонок: тонкая линия + широкая зона захвата -->
                                <Border x:Name="VersionSplitter" Grid.Column="4"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="Изменить ширину колонки"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                                <Border x:Name="LaunchModeSplitter" Grid.Column="5"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="Изменить ширину колонки"
                                        Visibility="{Binding DataContext.ShowVersionColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                                <Border x:Name="ServerSplitter" Grid.Column="6"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="Изменить ширину колонки"
                                        Visibility="{Binding DataContext.ShowLaunchModeColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                                <Border x:Name="LastLaunchSplitter" Grid.Column="7"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="Изменить ширину колонки"
                                        Visibility="{Binding DataContext.ShowServerColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                            </Grid>
                            </Border>
                        </ScrollViewer>

                    <!-- Прокручиваемая область списка баз. Прокручивается только по вертикали,
                         заголовок таблицы выше остаётся на месте. -->
                    <!-- Список баз в виде дерева «группа в группе» -->
                    <TreeView x:Name="MainTree"
                              Grid.Row="1"
                              AllowDrop="True"
                              PreviewMouseMove="OnMainTree_PreviewMouseMove"
                              PreviewMouseWheel="OnMainTree_PreviewMouseWheel"
                              DragOver="OnMainTree_DragOver"
                              Drop="OnMainTree_Drop"
                              GiveFeedback="OnMainTree_GiveFeedback"
                              ItemsSource="{Binding GroupNodes}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              SelectedItemChanged="OnMainTree_SelectedItemChanged"
                              RequestBringIntoView="OnMainTree_RequestBringIntoView"
                              PreviewMouseDoubleClick="OnInfobaseTree_PreviewMouseDoubleClick"
                              PreviewMouseRightButtonDown="OnInfobaseTree_PreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonDown="OnInfobaseTree_PreviewMouseLeftButtonDown">

                        <!-- Виртуализация панели: при большом числе баз создаются только видимые строки. -->
                        <TreeView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </TreeView.ItemsPanel>

                        <TreeView.Resources>
                            <!-- Узел группы: заголовок + вложенные подгруппы и базы -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:GroupNodeViewModel}"
                                                      ItemsSource="{Binding Items}">
                                <Border CornerRadius="6" Padding="8,6" Margin="0,1">
                                    <Border.Style>
                                        <!-- Стиль подсветки выбранной группы: при выделении (IsSelected)
                                             рамка акцентного цвета, чтобы выделение было видно поверх цвета группы. -->
                                        <Style TargetType="Border">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource GroupColorConverter}">
                                                        <Binding Path="FullPath"/>
                                                        <Binding Path="DataContext.Groups" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Data="{Binding Icon, Converter={StaticResource IconKeyToGeometryConverter}}">
                                            <Path.Fill>
                                                <MultiBinding Converter="{StaticResource GroupTextColorConverter}">
                                                    <Binding Path="FullPath"/>
                                                    <Binding Path="DataContext.Groups" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Path.Fill>
                                        </Path>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource GroupTextColorConverter}">
                                                    <Binding Path="FullPath"/>
                                                    <Binding Path="DataContext.Groups" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TotalInfobaseCount, StringFormat=' ({0})'}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource GroupTextColorConverter}">
                                                    <Binding Path="FullPath"/>
                                                    <Binding Path="DataContext.Groups" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>

                            <!-- Строка информационной базы -->
                            <DataTemplate DataType="{x:Type models:Infobase}">
                                <Border Padding="0,3" Margin="0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="CornerRadius" Value="4"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </Trigger>
                                                <!-- Подсветка выбранной базы: синхронизируется со свойством
                                                     IsSelected элемента дерева, которое устанавливается в code-behind
                                                     при клике левой кнопкой мыши. -->
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Первая колонка компенсирует левую колонку шаблона узла (30px)
                                                 и выравнивает данные с колонками заголовков таблицы. -->
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="{Binding DataContext.ShowFavoritesButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=26}"/>
                                            <ColumnDefinition Width="{Binding DataContext.ShowPinnedButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=26}"/>
                                            <ColumnDefinition Width="{Binding DataContext.NameColumnWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DoubleToGridLength}, ConverterParameter=250}"/>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="120">
                                                        <Binding Path="DataContext.ShowVersionColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.VersionColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="120">
                                                        <Binding Path="DataContext.ShowLaunchModeColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.LaunchModeColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="200">
                                                        <Binding Path="DataContext.ShowServerColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ServerColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="140">
                                                        <Binding Path="DataContext.ShowLastLaunchColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.LastLaunchColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.ToggleFavoriteForCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Padding="0"
                                                MinWidth="0" MinHeight="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                ToolTip="Добавить/убрать из избранного (Alt+N — быстрый запуск)">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Star" Width="14" Height="14" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <TextBlock Text="{Binding FavoriteHotkeyDisplay}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="1,0,0,0"
                                                           Foreground="{DynamicResource FavoriteBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FavoriteHotkeyNumber}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2"
                                                Command="{Binding DataContext.TogglePinForCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Padding="0"
                                                MinWidth="0" MinHeight="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                ToolTip="Закрепить/открепить базу вверху списка">
                                            <materialDesign:PackIcon Kind="Pin" Width="14" Height="14">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>

                                        <TextBlock Grid.Column="3" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="4" Text="{Binding PlatformVersion}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="5" Text="{Binding ParsedLaunchMode}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="6" Text="{Binding ServerDatabaseDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="7" Text="{Binding LastLaunchDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>

                                        <!-- Теги базы -->
                                        <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="6"
                                                    Orientation="Horizontal" Margin="0,0,0,0"
                                                    Visibility="{Binding DataContext.ShowTags, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource ItemHoverBrush}" CornerRadius="3"
                                                                Padding="4,0" Margin="0,0,3,0" Height="16"
                                                                VerticalAlignment="Center"
                                                                BorderThickness="0" SnapsToDevicePixels="True">
                                                            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                                                <Button DockPanel.Dock="Left"
                                                                        Command="{Binding DataContext.SearchByTagCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Padding="0" Margin="0" Height="14" Width="Auto"
                                                                        MinHeight="0" MinWidth="0" MaxHeight="14"
                                                                        Cursor="Hand" ToolTip="Показать базы с этим тегом"
                                                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}"
                                                                                       FontSize="11" FontWeight="SemiBold"
                                                                                       VerticalAlignment="Center"
                                                                                       LineHeight="12" LineStackingStrategy="BlockLineHeight"/>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                                <Button DockPanel.Dock="Left" Click="OnRemoveTag_Click"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Padding="0" Margin="2,0,0,0" Height="12" Width="12"
                                                                        MinHeight="0" MinWidth="0" MaxHeight="12"
                                                                        Cursor="Hand" ToolTip="Удалить тег"
                                                                        VerticalAlignment="Center">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <TextBlock Text="×" FontSize="11" LineHeight="12"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       LineStackingStrategy="BlockLineHeight"/>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button x:Name="AddTagButton" Content="+ тег"
                                                    Click="OnAddTagInline_Click"
                                                    Background="Transparent" BorderThickness="0" Padding="2,0"
                                                    Cursor="Hand" Foreground="{DynamicResource TextSecondaryBrush}"
                                                    FontSize="11" Height="16" MinHeight="0" VerticalAlignment="Center" Margin="2,0,0,0"
                                                    ToolTip="Добавить тег к базе"/>
                                            <TextBox x:Name="InlineTagBox" Visibility="Collapsed"
                                                     Width="120" FontSize="12" Padding="4,2" Height="22"
                                                     Margin="4,0,0,0" VerticalAlignment="Center"
                                                     KeyDown="OnInlineTagBox_KeyDown"
                                                     LostFocus="OnInlineTagBox_LostFocus"
                                                     ToolTip="Введите тег и нажмите Enter"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </TreeView.Resources>

                        <TreeView.ItemContainerStyle>
                            <!-- Стиль элемента дерева: заголовок группы/базы и вложенные элементы.
                                 Вложенные подгруппы сдвигаются вправо (Margin на ItemsPresenter),
                                 формируя классический вид дерева «группа в группе». -->
                            <Style TargetType="TreeViewItem">
                                <!-- Выбором полностью управляет code-behind (OnInfobaseTree_PreviewMouseLeftButtonDown).
                                     Двухсторонняя привязка IsSelected к модели здесь НЕ используется: она порождает
                                     каскад событий SelectedItemChanged (база дублируется в «Закреплённых» и в своей
                                     группе), что приводит к бесконечной рекурсии и StackOverflowException. -->
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Отдельная левая колонка под кнопку свернуть/развернуть,
                                                             вне панели самой группы. -->
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Кнопка свернуть/развернуть: «+» = группа свёрнута, «−» = развёрнута.
                                                         Видна только у узлов с дочерними элементами (группы). -->
                                                    <Button x:Name="Expander" Grid.Column="0"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ToggleGroupExpandedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Width="26" Height="26"
                                                            Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="Свернуть / развернуть группу">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="ToolTip" Value="Свернуть группу"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False">
                                                                        <Setter Property="ToolTip" Value="Развернуть группу"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="ExpanderBorder"
                                                                        Width="22" Height="22"
                                                                        Background="{DynamicResource CardBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                                        BorderThickness="1.5"
                                                                        CornerRadius="5"
                                                                        SnapsToDevicePixels="True">
                                                                    <Grid>
                                                                        <!-- «−» : группа развёрнута -->
                                                                        <Path x:Name="IconExpanded"
                                                                              Width="12" Height="12"
                                                                              Stretch="Uniform"
                                                                              Fill="{DynamicResource AccentBrush}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Data="{StaticResource IconMinus}"
                                                                              Visibility="Visible"/>
                                                                        <!-- «+» : группа свёрнута -->
                                                                        <Path x:Name="IconCollapsed"
                                                                              Width="12" Height="12"
                                                                              Stretch="Uniform"
                                                                              Fill="{DynamicResource AccentBrush}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Data="{StaticResource IconPlus}"
                                                                              Visibility="Collapsed"/>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <!-- Состояние по TreeViewItem.IsExpanded (не DataContext — у Infobase нет IsExpanded) -->
                                                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False">
                                                                        <Setter TargetName="IconExpanded" Property="Visibility" Value="Collapsed"/>
                                                                        <Setter TargetName="IconCollapsed" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter TargetName="IconExpanded" Property="Fill" Value="White"/>
                                                                        <Setter TargetName="IconCollapsed" Property="Fill" Value="White"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                                                        <Setter TargetName="IconExpanded" Property="Fill" Value="White"/>
                                                                        <Setter TargetName="IconCollapsed" Property="Fill" Value="White"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Border x:Name="row" Grid.Column="1" Background="Transparent">
                                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <!-- Вложенные уровни сдвигаются вправо (Margin накапливается
                                                     рекурсивно на каждом уровне), формируя классическую иерархию
                                                     дерева «группа в группе». -->
                                                <ItemsPresenter x:Name="ItemsHost" Margin="24,0,0,0"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </Trigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                                        <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource TreeSelectedBrush}"/>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Синхронизация только для GroupNodeViewModel (у Infobase нет IsExpanded).
                                         Проверка по наличию дочерних элементов + FallbackValue глушит ошибки. -->
                                    <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="IsExpanded">
                                            <Setter.Value>
                                                <Binding Path="IsExpanded" Mode="TwoWay"
                                                         FallbackValue="True"
                                                         TargetNullValue="True"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <!-- Контекстное меню по правой кнопке мыши для выбранной базы -->
                        <TreeView.ContextMenu>
                            <ContextMenu Style="{DynamicResource ModernContextMenu}">
                                <MenuItem Header="Запустить 1С:Предприятие" Command="{Binding LaunchEnterpriseCommand}" InputGestureText="{Binding HotkeyEnterprise}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Play" Width="16" Height="16" Foreground="#22C55E"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Запустить Конфигуратор" Command="{Binding LaunchConfiguratorCommand}" InputGestureText="F4" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Cog" Width="16" Height="16" Foreground="#3B82F6"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Изменить настройки" Command="{Binding EditInfobaseCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="#3B82F6"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Избранное" Command="{Binding ToggleFavoriteCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Star" Width="16" Height="16" Foreground="#FBBF24"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Закрепить" Command="{Binding TogglePinCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Pin" Width="16" Height="16" Foreground="#8B5CF6"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Очистить кеш базы" Command="{Binding ClearCacheCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Broom" Width="16" Height="16" Foreground="#14B8A6"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Копировать строку подключения" Command="{Binding CopyConnectionStringCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Foreground="#06B6D4"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Добавить..." Command="{Binding AddInfobaseCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="#22C55E"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Удалить" Command="{Binding DeleteInfobaseCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#EF4444"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        </TreeView>
                    
                </Grid>
                </Grid>
            </Border>

            <!-- ============ Правая панель: сведения и действия ============ -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="16,14">
                    <StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedInfobase}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="Database" Width="28" Height="28"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedInfobase.Name}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedInfobase.GroupDisplay, StringFormat=Группа: {0}}"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <WrapPanel Margin="0,0,0,12">
                                <Border Background="#FEF3C7" CornerRadius="8" Padding="8,3" Margin="0,0,6,4"
                                        Visibility="{Binding SelectedInfobase.IsFavorite, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Star" Width="12" Height="12" Foreground="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedInfobase.FavoriteHotkeyDisplay, StringFormat=Избранное {0}}" FontSize="11" Foreground="#92400E"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EDE9FE" CornerRadius="8" Padding="8,3" Margin="0,0,6,4"
                                        Visibility="{Binding SelectedInfobase.IsPinned, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pin" Width="12" Height="12" Foreground="#8B5CF6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Закреплено" FontSize="11" Foreground="#5B21B6"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="Информация о подключении" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedInfobase.ConnectionTypeDisplay}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Сервер / путь" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedInfobase.ConnectionPathDisplay}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Сервер/База" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInfobase.ServerDatabaseDisplay}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Строка" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedInfobase.ConnectionStringDisplay}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Платформа" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedInfobase.PlatformVersion}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Режим запуска" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedInfobase.ParsedLaunchMode}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Клиент" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedInfobase.ClientType}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Разрядность" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedInfobase.Architecture}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Параметры" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedInfobase.LaunchParameters}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Последний запуск" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedInfobase.LastLaunchDisplay}" FontSize="12" Margin="0,0,0,5"/>
                            </Grid>

                            <TextBlock Text="Описание" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedInfobase.Description}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <TextBlock Text="Теги" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding SelectedInfobase.Tags}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ItemHoverBrush}" CornerRadius="8" Padding="8,3" Margin="0,0,4,4"
                                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Когда база не выбрана — группа или подсказка -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedInfobase}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Width="28" Height="28" Stretch="Uniform" Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource AccentBrush}"
                                      Data="{Binding SelectedGroupNode.Icon, Converter={StaticResource IconKeyToGeometryConverter}}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedGroupNode.DisplayName, TargetNullValue=Нет выбора}"
                                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedGroupNode.FullPath}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Выберите информационную базу в списке, чтобы увидеть параметры подключения, запуск и теги."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0,4,0,12"/>

                        <!-- Действия -->
                        <TextBlock Text="Действия" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"/>

                        <Button Command="{Binding LaunchEnterpriseCommand}"
                                Style="{DynamicResource ActionPanelButton}" Padding="14,12" Margin="8,0,8,8"
                                ToolTip="{Binding HotkeyEnterprise, StringFormat=Запустить 1С:Предприятие ({0})}">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Запустить 1С:Предприятие" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HotkeyEnterprise}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="White" Opacity="0.9" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding LaunchConfiguratorCommand}"
                                Style="{DynamicResource ActionPanelSecondaryButton}" Padding="14,12" Margin="8,0,8,8"
                                ToolTip="{Binding HotkeyConfigurator, StringFormat=Открыть конфигуратор ({0})}">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="Cog" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Открыть конфигуратор" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HotkeyConfigurator}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Opacity="0.7" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding EditInfobaseCommand}"
                                Style="{DynamicResource ActionPanelSecondaryButton}" Margin="8,0,8,8" Padding="14,11"
                                ToolTip="Изменить настройки базы">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Изменить настройки" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleFavoriteCommand}"
                                Style="{DynamicResource ActionPanelSecondaryButton}" Margin="8,0,8,8" Padding="14,11"
                                ToolTip="Добавить / убрать из избранного">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="Star" Width="16" Height="16" Foreground="#FBBF24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Избранное" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding TogglePinCommand}"
                                Style="{DynamicResource ActionPanelSecondaryButton}" Margin="8,0,8,8" Padding="14,11"
                                ToolTip="Закрепить базу вверху списка">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="Pin" Width="16" Height="16" Foreground="#8B5CF6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Закрепить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearCacheCommand}"
                                Style="{DynamicResource ActionPanelSecondaryButton}" Margin="8,0,8,8" Padding="14,11"
                                ToolTip="Очистить кэш 1С">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="DeleteSweep" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Очистить кэш" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddInfobaseCommand}"
                                Style="{DynamicResource ActionPanelSecondaryButton}" Margin="8,0,8,8" Padding="14,11"
                                ToolTip="Добавить базу или группу">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0,8,0,12"/>

                        <Button Command="{Binding DeleteInfobaseCommand}"
                                Style="{DynamicResource ActionPanelSecondaryButton}" Padding="14,11" Margin="8,0,8,0"
                                ToolTip="Удалить">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Удалить" VerticalAlignment="Center" Foreground="#EF4444"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- ===================== Строка состояния ============ -->
<Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SelectedInfobase.ConnectionStringDisplay}"
                           Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="Строка подключения выбранной базы">
                    <TextBlock.ContextMenu>
                        <ContextMenu Style="{DynamicResource ModernContextMenu}">
                            <MenuItem Header="Копировать путь"
                                      Command="{Binding CopyConnectionStringCommand}"
                                      Style="{DynamicResource ModernMenuItem}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding SyncMessage}"
                           Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Результат последней синхронизации с файлом ibases.v8i"/>
            </Grid>
        </Border>
    </Grid>
</Window>
