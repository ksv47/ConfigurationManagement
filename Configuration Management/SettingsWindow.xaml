                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Нижняя панель -->
                    <TabItem Style="{StaticResource SettingsSubTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DockBottom" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
