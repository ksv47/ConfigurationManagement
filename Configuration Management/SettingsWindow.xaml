<Window x:Class="Configuration_Management.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Configuration_Management.Models"
        xmlns:vm="clr-namespace:Configuration_Management.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Настройки"
        Icon="{StaticResource AppIcon}"
        Width="820"
        MinWidth="720"
        MinHeight="640"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                            <Border Grid.Row="0" Background="{TemplateBinding Background}"
                                    Padding="12,8,12,0" Margin="8,0,0,0" HorizontalAlignment="Left">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.FontSize="13"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- ===================== Стиль вкладок (слева, вертикальная панель) ===================== -->
        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
        </Style>

        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,3,0"
                                CornerRadius="6,0,0,6"
                                MinWidth="140" MaxWidth="200"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource SettingsTabControl}"
                    HorizontalAlignment="Stretch">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <!-- ============ Вкладка «Платформы» ============ -->
            <TabItem Header="Платформы" Style="{StaticResource SettingsTabItem}">
                <Grid Margin="4,12,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Установленные версии платформы 1С:Предприятие."
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TreeView x:Name="PlatformsTree" Grid.Column="0" MinHeight="200"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderBrushColor}"
                                  BorderThickness="1"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ToolTip="Версии платформы 1С, сгруппированные по мажорной версии">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:PlatformVersionGroup}"
                                                          ItemsSource="{Binding Versions}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,6"
                                VerticalAlignment="Top"
                                Style="{DynamicResource SecondaryButton}"
                                Click="OnRefreshPlatforms_Click"
                                ToolTip="Обновить список установленных версий платформы">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Обновить список" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="StatusText" Grid.Row="2"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- ============ Вкладка «Отображение» ============ -->
            <TabItem Header="Отображение" Style="{StaticResource SettingsTabItem}">
                <Grid Margin="4,12,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Настройки отображения списка информационных баз: видимые колонки, кнопки и теги."
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <!-- Видимые колонки списка -->
                    <GroupBox Grid.Row="1" Header="Колонки списка баз" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox x:Name="ShowNameColumnCheck" Content="Название" IsChecked="True" IsEnabled="False"/>
                            <CheckBox x:Name="ShowVersionColumnCheck" Content="Версия платформы"/>
                            <CheckBox x:Name="ShowLaunchModeColumnCheck" Content="Режим запуска"/>
                            <CheckBox x:Name="ShowServerColumnCheck" Content="Сервер/База"/>
                            <CheckBox x:Name="ShowLastLaunchColumnCheck" Content="Последний запуск"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Кнопки и метки -->
                    <GroupBox Grid.Row="2" Header="Кнопки и метки" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox x:Name="ShowFavoritesButtonCheck" Content="Кнопка «Избранное»"/>
                            <CheckBox x:Name="ShowPinnedButtonCheck" Content="Кнопка «Закрепить»"/>
                            <CheckBox x:Name="ShowTagsCheck" Content="Показывать теги баз"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Поведение списка -->
                    <GroupBox Grid.Row="3" Header="Поведение списка" Padding="10,8">
                        <StackPanel>
                            <CheckBox x:Name="GroupByGroupCheck" Content="Группировать базы по группам"/>
                            <CheckBox x:Name="ShowFavoritesOnlyCheck" Content="Показывать только избранные базы"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============ Вкладка «Группы» ============ -->
            <TabItem Header="Группы" Style="{StaticResource SettingsTabItem}">
                <Grid Margin="4,12,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TreeView x:Name="GroupsTree"
                              Grid.Column="0"
                              Margin="0,0,12,0"
                              MinHeight="280"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderBrushColor}"
                              Background="Transparent"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:GroupNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Color}"/>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Group.Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>

                        <TreeView.ItemContainerStyle>
                            <!-- Кастомный шаблон узла: заметные кнопки +/− вместо стандартных стрелок.
                                 Широкая колонка-расширитель накапливается с каждым уровнем,
                                 благодаря чему вложенные группы визуально отделяются отступами. -->
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Современная кнопка свернуть/развернуть (chevron) -->
                                                        <ToggleButton x:Name="Expander"
                                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      ClickMode="Press"
                                                                      Width="26" Height="26" Margin="2,0,0,0"
                                                                      Background="Transparent" BorderThickness="0"
                                                                      ToolTip="Свернуть/развернуть группу">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="ExpanderBorder"
                                                                            Width="24" Height="24"
                                                                            Background="{DynamicResource ItemHoverBrush}"
                                                                            BorderBrush="{DynamicResource BorderBrushColor}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6">
                                                                        <Path x:Name="ExpanderIcon"
                                                                              Width="12" Height="12"
                                                                              Stretch="Uniform"
                                                                              Fill="{DynamicResource TextPrimaryBrush}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Data="{StaticResource IconChevronRight}"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="ExpanderIcon" Property="Data" Value="{StaticResource IconChevronDown}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                            <Setter TargetName="ExpanderIcon" Property="Fill" Value="White"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                                                            <Setter TargetName="ExpanderIcon" Property="Fill" Value="White"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                                          VerticalAlignment="Center" Margin="4,2,0,2"/>
                                                    </Grid>
                                                </Border>
                                                <!-- Отступ вложенных уровней: каждый вложенный узел сдвигается вправо,
                                                     благодаря чему вложенные группы визуально группируются под родителем. -->
                                                <ItemsPresenter x:Name="ItemsHost" Margin="30,0,0,0"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeSelectedBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <!-- ============ Кнопки управления группами ============ -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Style="{DynamicResource ModernButton}" Width="140"
                                Margin="0,0,0,8" Click="OnAddRoot_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SecondaryButton}" Width="140"
                                Margin="0,0,0,8" Click="OnAddSubgroup_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Подгруппу" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SecondaryButton}" Width="140"
                                Margin="0,0,0,8" Click="OnEditGroup_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Изменить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SecondaryButton}" Width="140"
                                Margin="0,0,0,8" Click="OnDeleteGroup_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator Margin="0,4,0,8" Background="{DynamicResource BorderBrushColor}"/>
                        <Button Style="{DynamicResource SecondaryButton}" Width="160"
                                Margin="0,0,0,8" Click="OnCollapseAll_Click"
                                ToolTip="Свернуть все группы">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="UnfoldLessHorizontal" Width="16" Height="16" Foreground="#6366F1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Свернуть все" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SecondaryButton}" Width="160"
                                Click="OnExpandAll_Click"
                                ToolTip="Развернуть все группы">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="UnfoldMoreHorizontal" Width="16" Height="16" Foreground="#8B5CF6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Развернуть все" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ Вкладка «ibases.v8i» ============ -->
            <TabItem Header="ibases.v8i" Style="{StaticResource SettingsTabItem}">
                <Grid Margin="4,12,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Синхронизация приложения со стандартным файлом списка баз 1С (ibases.v8i)."
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <!-- Синхронизация с ibases.v8i -->
                    <GroupBox Grid.Row="1" Header="Настройки синхронизации" Padding="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Режим синхронизации:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ComboBox x:Name="SyncModeComboBox" Width="260" Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="OnSyncMode_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Файл ibases.v8i:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="SyncFilePathTextBox" Width="380" Margin="10,0,0,0"
                                         VerticalAlignment="Center"/>
                                <Button x:Name="BrowseSyncFileButton" Content="Обзор…" Margin="6,0,0,0"
                                        Padding="10,3" VerticalAlignment="Center"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="OnBrowseSyncFile_Click"
                                        ToolTip="Выбрать файл ibases.v8i вручную"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Момент синхронизации:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ComboBox x:Name="SyncTriggerComboBox" Width="260" Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="OnSyncTrigger_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="SyncIntervalLabel" Text="Интервал (мин):"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="SyncIntervalTextBox" Width="60" Margin="10,0,0,0"
                                         VerticalAlignment="Center" TextAlignment="Center"
                                         TextChanged="OnSyncInterval_TextChanged"/>
                                <TextBlock x:Name="SyncScheduleLabel" Text="Время (ЧЧ:ММ):"
                                           VerticalAlignment="Center" Margin="16,0,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="SyncScheduleTimePicker" Width="70" Margin="10,0,0,0"
                                         VerticalAlignment="Center" TextAlignment="Center"
                                         TextChanged="OnSyncScheduleTime_TextChanged"/>
                            </StackPanel>

                            <TextBlock x:Name="SyncStatusText"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       Margin="0,4,0,8" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SyncImportButton" Style="{DynamicResource SecondaryButton}"
                                        Padding="10,6" Margin="0,0,8,0"
                                        Click="OnSyncImport_Click"
                                        ToolTip="Загрузить новые базы из файла ibases.v8i в приложение">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Download" Width="16" Height="16" Foreground="#F97316" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Загрузить из файла" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SyncExportButton" Style="{DynamicResource SecondaryButton}"
                                        Padding="10,6"
                                        Click="OnSyncExport_Click"
                                        ToolTip="Выгрузить базы приложения в файл ibases.v8i">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" Foreground="#A855F7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Выгрузить в файл" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                </Grid>
            </TabItem>

            <!-- ============ Вкладка «Дополнительные функции» ============ -->
            <TabItem Header="Дополнительно" Style="{StaticResource SettingsTabItem}">
                <Grid Margin="4,12,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Экспорт и загрузка списка баз, а также другие операции со списком."
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <!-- Экспорт / загрузка списка баз -->
                    <GroupBox Grid.Row="1" Header="Список информационных баз" Padding="8" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Style="{DynamicResource ModernButton}" Margin="0,0,0,8" Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    Click="OnExportInfobases_Click"
                                    ToolTip="Сохранить текущий список баз и групп в JSON-файл">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Export" Width="16" Height="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Экспорт списка баз в файл" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8" Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    Click="OnImportInfobases_Click"
                                    ToolTip="Загрузить список баз и групп из JSON-файла (заменяет текущий)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" Width="16" Height="16" Foreground="#F97316" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Загрузка списка баз из файла" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8" Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    Click="OnImportIbasesV8i_Click"
                                    ToolTip="Считать список баз из файла ibases.v8i и добавить/обновить базы">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDownload" Width="16" Height="16" Foreground="#14B8A6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Импорт из ibases.v8i" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </GroupBox>

                    <!-- Опасные операции -->
                    <GroupBox Grid.Row="2" Header="Опасные операции" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Очистка всего списка баз и групп. Действие необратимо."
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            <Button Style="{DynamicResource SecondaryButton}" Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    Click="OnClearAllInfobases_Click"
                                    ToolTip="Удалить все базы и группы">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Очистить весь список баз" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============ Кнопки ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="130" Height="34" Style="{DynamicResource ModernButton}"
                    Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="34" Style="{DynamicResource SecondaryButton}" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>