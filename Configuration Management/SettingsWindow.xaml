                                        <materialDesign:PackIcon Kind="Account" Width="16" Height="16" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Пользователь подключения" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
