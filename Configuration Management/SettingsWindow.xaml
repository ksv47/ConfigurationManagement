                </TabControl>

            </TabItem>

            <!-- ============ Вкладка «Клавиши» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="KeyboardOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="Клавиши" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="4,12,4,0" Padding="0,0,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Горячие клавиши действий"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HelpLink Margin="6,0,0,0"
                                               HelpText="Назначение горячих клавиш действий (по аналогии с конфигуратором 1С).&#10;&#10;• Установите курсор в поле и нажмите нужную комбинацию: Ctrl, Shift, Alt, Win (например Ctrl+Shift+F), либо F2–F12, Delete, Insert.&#10;• Backspace/Delete — сбросить назначение; «Нет» — клавиша не используется.&#10;• Esc — отменить текущий ввод.&#10;• Одна и та же клавиша не может быть назначена разным действиям.&#10;• Назначенные клавиши применяются сразу после сохранения настроек и отображаются на кнопках правой панели и в контекстном меню."/>
                        </StackPanel>
                        <TextBlock Text="Одна и та же клавиша не может быть назначена разным действиям. Установите курсор в поле и нажмите нужное сочетание (Ctrl, Shift, Alt и др.). Backspace/Delete — сбросить, «Нет» — клавиша не используется."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="1С:Предприятие:" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyEnterpriseBox" Grid.Row="0" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Конфигуратор:" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyConfiguratorBox" Grid.Row="1" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Избранное:" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyFavoriteBox" Grid.Row="2" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Изменить:" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyEditBox" Grid.Row="3" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Удалить:" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyDeleteBox" Grid.Row="4" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Очистить кэш:" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyClearCacheBox" Grid.Row="5" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Добавить базу:" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyAddBox" Grid.Row="6" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Закрепить:" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyPinBox" Grid.Row="7" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Показать все базы:" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyShowAllBox" Grid.Row="8" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Показать избранное:" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyShowFavoritesBox" Grid.Row="9" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Показать недавние:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyShowRecentBox" Grid.Row="10" Grid.Column="1"
                                                Height="34" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                        </Grid>

                        <TextBlock Text="Порядок избранного (Alt+1 … Alt+9)"
                                   FontWeight="SemiBold" Margin="0,4,0,6"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Порядок слотов определяет, какая база запускается по Alt+1, Alt+2 и т.д. Используйте стрелки для перемещения."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid MinHeight="140" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="FavoriteHotkeysList" Grid.Column="0"
                                     MinHeight="140" MaxHeight="220"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrushColor}"
                                     BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <Border Background="{DynamicResource FavoriteBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Number, StringFormat=Alt+{0}}" FontWeight="Bold" FontSize="12" Foreground="#1C1917"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,0,6"
                                        Click="OnFavoriteHotkeyUp_Click" ToolTip="Выше (меньший номер Alt)">
                                    <materialDesign:PackIcon Kind="ArrowUp" Width="18" Height="18"/>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButton}" Padding="10,6"
                                        Click="OnFavoriteHotkeyDown_Click" ToolTip="Ниже (больший номер Alt)">
                                    <materialDesign:PackIcon Kind="ArrowDown" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка «Настройки» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ApplicationCog" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="Настройки" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="4,12,4,0" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Поведение приложения"
                                   FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="AllowMultipleInstancesCheck" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ApplicationOutline" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Разрешить несколько экземпляров программы" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowTrayIconCheck" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrayFull" Width="16" Height="16" Foreground="#14B8A6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Значок в области уведомлений" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="CloseToTrayCheck" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Сворачивать в трей при закрытии" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="EscapeToTrayCheck">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Keyboard" Width="16" Height="16" Foreground="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="По Esc сворачивать в трей" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка «ibases.v8i» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocument" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="ibases.v8i" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="4,12,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Синхронизация приложения со стандартным файлом списка баз 1С (ibases.v8i)."
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <!-- Синхронизация с ibases.v8i -->
                    <GroupBox Grid.Row="1" Header="Настройки синхронизации" Padding="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-4,0,4">
                                <controls:HelpLink HelpText="Синхронизация со стандартным файлом списка баз 1С ibases.v8i.&#10;&#10;• Режим: отключена / только загрузка / только выгрузка / двусторонняя (сначала выгрузка, затем загрузка).&#10;• Файл: путь к ibases.v8i (по умолчанию %APPDATA%\1C\1CEStart\).&#10;• Момент синхронизации: при старте, по интервалу (мин) или по расписанию (ЧЧ:ММ).&#10;• «Загрузить из файла» — добавить базы из файла в приложение; «Выгрузить в файл» — наоборот.&#10;• Рекомендуется включать резервные копии ibases.v8i перед синхронизацией — их можно восстановить кнопкой «Восстановить из последней копии»."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Режим синхронизации:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ComboBox x:Name="SyncModeComboBox" Width="420" Height="40" Margin="10,0,0,0" FontSize="14"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="OnSyncMode_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Файл ibases.v8i:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="SyncFilePathTextBox" Width="380" Margin="10,0,0,0"
                                         VerticalAlignment="Center"/>
                                <Button x:Name="BrowseSyncFileButton" Content="Обзор…" Margin="6,0,0,0"
                                        Padding="10,3" VerticalAlignment="Center"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="OnBrowseSyncFile_Click"
                                        ToolTip="Выбрать файл ibases.v8i вручную"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Момент синхронизации:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ComboBox x:Name="SyncTriggerComboBox" Width="420" Height="40" Margin="10,0,0,0" FontSize="14"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="OnSyncTrigger_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="SyncIntervalLabel" Text="Интервал (мин):"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="SyncIntervalTextBox" Width="60" Margin="10,0,0,0"
                                         VerticalAlignment="Center" TextAlignment="Center"
                                         TextChanged="OnSyncInterval_TextChanged"/>
                                <TextBlock x:Name="SyncScheduleLabel" Text="Время (ЧЧ:ММ):"
                                           VerticalAlignment="Center" Margin="16,0,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="SyncScheduleTimePicker" Width="70" Margin="10,0,0,0"
                                         VerticalAlignment="Center" TextAlignment="Center"
                                         TextChanged="OnSyncScheduleTime_TextChanged"/>
                            </StackPanel>

                            <TextBlock x:Name="SyncStatusText"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       Margin="0,4,0,8" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SyncImportButton" Style="{DynamicResource SecondaryButton}"
                                        Padding="10,6" Margin="0,0,8,0"
                                        Click="OnSyncImport_Click"
                                        ToolTip="Загрузить новые базы из файла ibases.v8i в приложение">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Download" Width="16" Height="16" Foreground="#F97316" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Загрузить из файла" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SyncExportButton" Style="{DynamicResource SecondaryButton}"
                                        Padding="10,6"
                                        Click="OnSyncExport_Click"
                                        ToolTip="Выгрузить базы приложения в файл ibases.v8i">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" Foreground="#A855F7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Выгрузить в файл" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Separator Margin="0,12,0,12"/>

                            <CheckBox x:Name="IbasesBackupEnabledCheck"
                                      Content="Создавать резервные копии ibases.v8i перед синхронизацией"
                                      IsChecked="True" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,6">
                                <TextBlock Text="Хранить копий:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="IbasesBackupKeepCountBox" Width="50" Margin="8,0,0,0"
                                         Text="5" VerticalAlignment="Center"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <TextBlock Text="Копии сохраняются рядом с файлом: ibases.v8i.bak_yyyyMMdd_HHmmss"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="24,0,0,8"/>
                            <Button Style="{DynamicResource SecondaryButton}" Padding="10,6"
                                    HorizontalAlignment="Left"
                                    Click="OnRestoreIbasesBackup_Click"
                                    ToolTip="Восстановить ibases.v8i из последней резервной копии">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BackupRestore" Width="16" Height="16" Foreground="#0EA5E9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Восстановить из последней копии" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </GroupBox>

                </Grid>
            </TabItem>

            <!-- ============ Вкладка «Базы» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Database" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="Базы" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="4,12,4,0" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Экспорт и загрузка списка баз, каталоги шаблонов и другие операции."
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"
                                   TextWrapping="Wrap"/>

                        <!-- Каталоги шаблонов — выше, т.к. часто нужны при создании ИБ -->
                        <GroupBox Header="Каталоги шаблонов конфигураций" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Как в стартере 1С. Пустой список — пути из настроек 1С и %PUBLIC%\Documents\1C\1cv8\tmplts."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <ListBox x:Name="TemplatePathsList" MinHeight="100" MaxHeight="180" Margin="0,0,0,8"
                                         BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnAddTemplatePath_Click"
                                            ToolTip="Добавить каталог шаблонов">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Добавить…" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnEditTemplatePath_Click"
                                            ToolTip="Изменить выбранный путь">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderEdit" Width="16" Height="16" Foreground="#0EA5E9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Изменить…" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnRemoveTemplatePath_Click"
                                            ToolTip="Удалить выбранный путь из списка">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderRemove" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,0,4"
                                            Click="OnLoadDefaultTemplatePaths_Click"
                                            ToolTip="Загрузить пути из настроек 1С и стандартный каталог tmplts">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Download" Width="16" Height="16" Foreground="#8B5CF6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Из 1С" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Экспорт / загрузка списка баз -->
                        <GroupBox Header="Список информационных баз" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <Button Style="{DynamicResource ModernButton}" Margin="0,0,0,8" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnExportInfobases_Click"
                                        ToolTip="Сохранить текущий список баз и групп в JSON-файл">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Export" Width="16" Height="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Экспорт списка баз в файл" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnImportInfobases_Click"
                                        ToolTip="Загрузить список баз и групп из JSON-файла (заменяет текущий)">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Import" Width="16" Height="16" Foreground="#F97316" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Загрузка списка баз из файла" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButton}" Margin="0,0,0,0" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnImportIbasesV8i_Click"
                                        ToolTip="Считать список баз из файла ibases.v8i и добавить/обновить базы">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDownload" Width="16" Height="16" Foreground="#14B8A6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Импорт из ibases.v8i" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>

                        <!-- Сервис (по аналогии со StartManager) -->
                        <GroupBox Header="Обслуживание" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Операции из альтернативных стартеров 1С: проверка файловых баз и завершение процессов платформы."
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>
                                <Button Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnRemoveMissingFileBases_Click"
                                        ToolTip="Удалить из списка файловые базы, у которых нет каталога или файла 1Cv8.1CD">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderRemove" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Удалить отсутствующие файловые базы" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButton}" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnKillOneCProcesses_Click"
                                        ToolTip="Завершить процессы 1cv8, 1cv8c и связанные (зависшие сеансы)">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloseNetwork" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Завершить процессы 1С" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>

                        <!-- Опасные операции -->
                        <GroupBox Header="Опасные операции" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Очистка всего списка баз и групп. Действие необратимо."
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>
                                <Button Style="{DynamicResource SecondaryButton}" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnClearAllInfobases_Click"
                                        ToolTip="Удалить все базы и группы">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Очистить весь список баз" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка «О программе» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="О программе" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,12,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Управление конфигурациями 1С" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HelpLink Margin="8,0,0,0" VerticalAlignment="Center"
                                               HelpText="Версия: 0.2.7.3.&#10;&#10;Это десктопное приложение для управления информационными базами 1С:Предприятие 8.3 — замена стандартному списку баз 1С.&#10;&#10;• Во многих окнах рядом с элементами есть значок «?» — нажмите его, чтобы увидеть подсказку о том, как работает этот элемент.&#10;• Полное описание возможностей и архитектуры — в файле README.md репозитория."/>
                        </StackPanel>
                        <TextBlock Text="Автор: Sivatorov" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="Публикация на Infostart:" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Margin="0,0,0,12" Cursor="Hand" TextDecorations="Underline"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="https://infostart.ru/1c/tools/2764888/"
                                   MouseLeftButtonUp="OnAboutLink_Click"
                                   Tag="https://infostart.ru/1c/tools/2764888/"/>
                        <TextBlock Text="Репозиторий GitHub:" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Cursor="Hand" TextDecorations="Underline"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="https://github.com/sivatorov/ConfigurationManagement"
                                   MouseLeftButtonUp="OnAboutLink_Click"
                                   Tag="https://github.com/sivatorov/ConfigurationManagement"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ============ Кнопки ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="140" Height="36" Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click"
                    Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Сохранить" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Width="140" Height="36" IsCancel="True" Click="OnCancel_Click"
                    Background="Transparent" Cursor="Hand" BorderThickness="1.5"
                    BorderBrush="#EF4444" Foreground="#EF4444">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>