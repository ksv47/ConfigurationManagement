<Window x:Class="Configuration_Management.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Configuration_Management.Models"
        xmlns:vm="clr-namespace:Configuration_Management.ViewModels"
        xmlns:controls="clr-namespace:Configuration_Management.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Настройки"
        Icon="{StaticResource AppIcon}"
        Width="880"
        MinWidth="760"
        MinHeight="560"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                            <Border Grid.Row="0" Background="{TemplateBinding Background}"
                                    Padding="12,8,12,0" Margin="8,0,0,0" HorizontalAlignment="Left">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.FontSize="13"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- ===================== Стиль вкладок (слева, вертикальная панель) ===================== -->
        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Отступ снизу у списка вкладок — выделение последней не обрезается -->
                            <Border Grid.Column="0" Padding="0,4,8,12" Background="Transparent"
                                    ClipToBounds="False">
                                <StackPanel IsItemsHost="True" ClipToBounds="False"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="SelectedContent"
                                              Margin="8,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- Полный фон + скругление; снизу запас Margin у TabItem, чтобы не обрезалось -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,3,0"
                                CornerRadius="8"
                                Width="{TemplateBinding Width}"
                                MinHeight="40"
                                SnapsToDevicePixels="True"
                                ClipToBounds="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Горизонтальные вкладки второго уровня (Отображение → группы) -->
        <Style x:Key="SettingsSubTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Полоса вкладок: равная ширина, общая линия снизу -->
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,0,0,10">
                                <UniformGrid Rows="1" IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSubTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Margin="0,0,0,-1"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <!-- Только нижняя акцентная линия — без заливки, чтобы не спорить с боковым меню -->
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource SettingsTabControl}"
                    HorizontalAlignment="Stretch">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <!-- ============ Вкладка «Платформы» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Server" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="Платформы" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="4,12,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Установленные версии платформы 1С:Предприятие."
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TreeView x:Name="PlatformsTree" Grid.Column="0" MinHeight="180"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderBrushColor}"
                                  BorderThickness="1"
                                  Padding="6,4"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ToolTip="Линия (8.3) → разрядность → сборка с путём">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:PlatformVersionGroup}"
                                                          ItemsSource="{Binding Children}">
                                    <Border Margin="0,2" Padding="6,4" CornerRadius="4"
                                            Background="{DynamicResource ItemHoverBrush}"
                                            ToolTip="{Binding Path}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Width="14" Height="14"
                                                                     Margin="0,2,8,0" VerticalAlignment="Top">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="Folder"/>
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Line">
                                                                <Setter Property="Kind" Value="Folder"/>
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="BuildGroup">
                                                                <Setter Property="Kind" Value="FolderOpen"/>
                                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="LeafX64">
                                                                <Setter Property="Kind" Value="CubeOutline"/>
                                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="LeafX32">
                                                                <Setter Property="Kind" Value="Cube"/>
                                                                <Setter Property="Foreground" Value="#8B5CF6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Leaf">
                                                                <Setter Property="Kind" Value="Application"/>
                                                                <Setter Property="Foreground" Value="#0EA5E9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
                                    <Setter Property="IsExpanded" Value="True"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                        <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,6"
                                VerticalAlignment="Top"
                                Style="{DynamicResource SecondaryButton}"
                                Click="OnRefreshPlatforms_Click"
                                ToolTip="Обновить список установленных версий платформы (стандартные и дополнительные пути)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Обновить список" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="StatusText" Grid.Row="2"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Дополнительные пути поиска -->
                    <GroupBox Grid.Row="3" Header="Дополнительные пути поиска" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="Укажите папки, в которых установлены платформы 1С вне стандартных каталогов Program Files. Можно указать корень установки, каталог 1cv8 или папку конкретной версии."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ListBox x:Name="AdditionalPathsList" Grid.Row="1"
                                     MinHeight="80" MaxHeight="140"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrushColor}"
                                     BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionMode="Single"
                                     ToolTip="Дополнительные каталоги для поиска версий платформы"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Padding="10,6" Margin="0,0,8,0"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="OnAddPlatformPath_Click"
                                        ToolTip="Добавить папку для поиска платформы 1С">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Добавить папку" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="10,6" Margin="0,0,8,0"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="OnEditPlatformPath_Click"
                                        ToolTip="Изменить выбранную папку">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderEdit" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Изменить" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="10,6"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="OnRemovePlatformPath_Click"
                                        ToolTip="Удалить выбранную папку из списка">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderRemove" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============ Вкладка «Отображение» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="Отображение" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <TabControl Margin="0,4,0,0" Style="{StaticResource SettingsSubTabControl}">
                    <!-- Значки и кнопки -->
                    <TabItem Style="{StaticResource SettingsSubTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StarOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                <TextBlock Text="Значки" VerticalAlignment="Center" ToolTip="Значки и кнопки"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,4,4">
                            <StackPanel>
                                <TextBlock Text="Какие элементы управления показывать в строках списка баз."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowFavoritesButtonCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Star" Width="16" Height="16" Foreground="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Кнопка «Избранное»" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowPinnedButtonCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pin" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Кнопка «Закрепить»" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowTagsCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TagOutline" Width="16" Height="16" Foreground="#EC4899" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Теги у баз в списке" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowTagFilterPanelCheck">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilterVariant" Width="16" Height="16" Foreground="#EC4899" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Панель быстрого отбора по тегам" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Колонки -->
                    <TabItem Style="{StaticResource SettingsSubTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewColumn" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                <TextBlock Text="Колонки" VerticalAlignment="Center" ToolTip="Колонки списка"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,4,4">
                            <StackPanel>
                                <TextBlock Text="Видимые колонки в таблице информационных баз."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowNameColumnCheck" IsChecked="True" IsEnabled="False" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FormatTitle" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Название" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowVersionColumnCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CubeOutline" Width="16" Height="16" Foreground="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Версия платформы" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowConfigurationColumnCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="16" Height="16" Foreground="#EC4899" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Конфигурация (название и версия)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowLaunchModeColumnCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Режим запуска" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowServerColumnCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Server" Width="16" Height="16" Foreground="#14B8A6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Сервер/База" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowLastLaunchColumnCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Последний запуск" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowSizeColumnCheck">
                                    <StackPanel Orientation="Horizontal">
