<Application x:Class="Configuration_Management.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Configuration_Management"
             xmlns:conv="clr-namespace:Configuration_Management.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
            >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Amber" SecondaryColor="Blue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:GroupTextColorConverter x:Key="GroupTextColorConverter"/>
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter"/>

            <!-- ===================== Иконка приложения 0.2.6.10 ===================== -->
            <DrawingImage x:Key="AppIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <!-- Фон: indigo → blue → cyan, скруглённый квадрат -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E3A8A" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="0.45"/>
                                    <GradientStop Color="#3B82F6" Offset="0.75"/>
                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Цилиндр БД по центру -->
                        <GeometryDrawing Brush="#F8FAFC">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <PathGeometry Figures="M9,9 L9,21 A7,2.5 0 0 0 23,21 L23,9"/>
                                    <EllipseGeometry Center="16,21" RadiusX="7" RadiusY="2.5"/>
                                    <EllipseGeometry Center="16,15" RadiusX="7" RadiusY="2.5"/>
                                    <EllipseGeometry Center="16,9" RadiusX="7" RadiusY="2.5"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FFFFFF">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="16,9" RadiusX="7" RadiusY="2.5"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Янтарный бейдж -->
                        <GeometryDrawing Brush="#FBBF24">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="24,23" RadiusX="4.2" RadiusY="4.2"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Галочка на бейдже -->
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#1E293B" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M21.8,23.2 L23.2,24.6 L26.4,21.2"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- ===================== Собственные кнопки управления окном =====================
                 Общие для всех окон: главное окно и диалоговые окна (WindowChromeHelper)
                 переиспользуют эти стили. Цвет значка и hover-подложка берутся из активной
                 темы через DynamicResource (TextSecondaryBrush / ItemHoverBrush /
                 AccentPressedBrush), поэтому корректно переключаются между темами. -->
            <Style x:Key="WindowControlButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0" CornerRadius="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Варианты кнопок для акцентной шапки (активное главное окно / заголовок
                 диалогов): базовый цвет значка ButtonTextBrush (читается на акцентном фоне),
                 а hover/pressed-состояния наследуются из базового шаблона. Задаём цвет именно
                 сеттером стиля (BasedOn), а не локальным значением: локальное значение в WPF
                 имеет приоритет над шаблонными триггерами и «ломало» бы белое выделение
                 кнопки «закрыть» при наведении. -->
            <Style x:Key="WindowControlButtonOnAccent" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            </Style>

            <!-- Кнопка «закрыть» окна: как WindowControlButton, но с красной подложкой
                 при наведении/нажатии (классический алый) и белым значком на ней. -->
            <Style x:Key="WindowControlCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0" CornerRadius="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#C50F1F"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Вариант кнопки «закрыть» для акцентной шапки: базовый цвет значка
                 ButtonTextBrush (читается на акцентном фоне), hover/pressed-состояния
                 наследуются из базового шаблона. -->
            <Style x:Key="WindowControlCloseButtonOnAccent" TargetType="Button" BasedOn="{StaticResource WindowControlCloseButton}">
                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
