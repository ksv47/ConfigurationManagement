<Window x:Class="Configuration_Management.TagInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Добавить тег"
        Icon="{StaticResource AppIcon}"
        Height="180" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Подпись ============ -->
        <TextBlock Grid.Row="0" Text="Введите название тега:" Margin="0,0,0,8"/>

        <!-- ============ Поле ввода ============ -->
        <TextBox x:Name="TagBox" Grid.Row="1" Padding="8,6"
                 KeyDown="OnTagBox_KeyDown"/>

        <!-- ============ Кнопки ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="90" Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="OkButton" Width="110"
                    IsDefault="True"
                    Style="{StaticResource ModernButton}"
                    Click="OnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>