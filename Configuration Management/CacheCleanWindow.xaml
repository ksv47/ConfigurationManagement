<Window x:Class="Configuration_Management.CacheCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Очистка кэша 1С"
        Icon="{StaticResource AppIcon}"
        Width="580" Height="540"
        MinHeight="440" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- ===== Material Design чекбокс (квадрат со скруглением, цветная галочка, ховер) ===== -->
        <Style x:Key="ModernMaterialCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Border x:Name="BoxBorder" Width="20" Height="20" CornerRadius="4"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1.5"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <materialDesign:PackIcon x:Name="CheckIcon" Kind="Check" Width="13" Height="13"
                                                                 Foreground="White" HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <materialDesign:PackIcon x:Name="DashIcon" Kind="Minus" Width="13" Height="13"
                                                                 Foreground="White" HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#16A34A"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#16A34A"/>
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#16A34A"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#16A34A"/>
                                <Setter TargetName="DashIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Кнопки «Выбрать все» / «Снять все»: без чекбокса, с подсветкой при наведении ===== -->
        <Style x:Key="SelectAllButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Text="Очистка кэша 1С: выбор типа кэша и баз"/>
        <TextBlock Grid.Row="1" FontSize="12" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="Программный и пользовательский кэш — разные данные и по-разному влияют на информационные базы. Выберите, какой кэш очистить и для каких баз."/>

        <!-- Тип кэша -->
        <TextBlock Grid.Row="2" FontWeight="SemiBold" Margin="0,16,0,6" Text="Тип очищаемого кэша"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <CheckBox x:Name="ProgramCacheCheck" Content="Программный кэш" Style="{StaticResource ModernMaterialCheckBox}"
                      Margin="0,0,8,0"
                      Checked="OnCacheKindChanged" Unchecked="OnCacheKindChanged"
                      ToolTip="%LOCALAPPDATA%\1C\1cv8…"/>
            <Rectangle Width="1" VerticalAlignment="Stretch" Margin="4,0,20,0"
                       Fill="{DynamicResource BorderBrushColor}"/>
            <CheckBox x:Name="UserCacheCheck" Content="Пользовательский кэш" Style="{StaticResource ModernMaterialCheckBox}"
                      Checked="OnCacheKindChanged" Unchecked="OnCacheKindChanged"
                      ToolTip="%APPDATA%\1C\1cv8…"/>
        </StackPanel>

        <!-- Выбор баз -->
        <Border Grid.Row="4" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <DockPanel>
                <!-- Поиск базы -->
                <Grid DockPanel.Dock="Top" Margin="8,8,8,2">
                    <TextBox x:Name="SearchBox"
                             materialDesign:HintAssist.Hint="Поиск базы…"
                             VerticalContentAlignment="Center"
                             Padding="10,7"
                             FontSize="13"
                             TextChanged="OnSearchTextChanged"/>
                </Grid>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1"
                        Padding="8,4" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SelectAllButton" Style="{StaticResource SelectAllButtonStyle}"
                                ToolTip="Выбрать все базы"
                                Click="OnSelectAllClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMultipleMarked" Width="16" Height="16"
                                                         Foreground="#16A34A" VerticalAlignment="Center"/>
                                <TextBlock Text="Выбрать все" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" x:Name="ClearSelectionButton"
                                Style="{StaticResource SelectAllButtonStyle}"
                                Margin="16,0,0,0" ToolTip="Снять выделение со всех баз"
                                Click="OnClearSelectionClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMultipleBlankOutline" Width="16" Height="16"
                                                         Foreground="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Text="Снять все" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2" x:Name="BasesCountText" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel x:Name="BasesPanel" Margin="4,2"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CleanButton" Width="180" Height="36" Margin="0,0,10,0" IsDefault="True"
                    Click="OnClean_Click" IsEnabled="False"
                    Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Broom" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Очистить" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Width="140" Height="36" IsCancel="True"
                    Background="Transparent" Cursor="Hand" BorderThickness="1.5"
                    BorderBrush="#EF4444" Foreground="#EF4444">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>