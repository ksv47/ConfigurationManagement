<UserControl x:Class="Configuration_Management.Controls.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Configuration_Management.Localization">

    <UserControl.Resources>
        <!-- Компактная плитка предустановленного цвета (фон задаётся в code-behind из Tag) -->
        <Style x:Key="PaletteColorButton" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Предпросмотр цвета ============ -->
        <Border x:Name="ColorPreview" Grid.Row="0" Height="40" CornerRadius="6" Margin="0,0,0,8"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"/>

        <!-- ============ Полная палитра (оттенок × насыщенность) ============ -->
        <TextBlock Grid.Row="1" Text="{loc:Loc ColorPicker.FullPalette}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <Grid x:Name="PaletteArea" Grid.Row="2" Height="100" ClipToBounds="True"
              Margin="0,0,0,6" Cursor="Hand">
            <Border x:Name="RainbowLayer"/>
            <Border x:Name="SaturationLayer"/>
            <Border x:Name="BrightnessOverlay" Background="Black"/>
            <Canvas x:Name="MarkerLayer">
                <Ellipse x:Name="ColorMarker" Width="16" Height="16" Stroke="White" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.6"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- ============ Яркость ============ -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="38"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ColorPicker.Brightness}" VerticalAlignment="Center"/>
            <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                    ValueChanged="OnBrightness_ValueChanged"/>
            <TextBlock x:Name="BrightnessValue" Grid.Column="2" Text="100%" TextAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- ============ Предустановленные цвета ============ -->
        <TextBlock Grid.Row="4" Text="{loc:Loc ColorPicker.Palette}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
        <UniformGrid x:Name="PaletteGrid" Grid.Row="5" Columns="16" Margin="0,0,0,6"/>

        <!-- ============ RGB-слайдеры ============ -->
        <Grid Grid.Row="6" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ColorPicker.ChannelRed}" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center"/>
            <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnRgb_ValueChanged"/>
            <TextBlock x:Name="RedValue" Grid.Column="2" Text="0" TextAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="7" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ColorPicker.ChannelGreen}" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center"/>
            <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnRgb_ValueChanged"/>
            <TextBlock x:Name="GreenValue" Grid.Column="2" Text="0" TextAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="8" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ColorPicker.ChannelBlue}" Foreground="#2D6CDF" FontWeight="Bold" VerticalAlignment="Center"/>
            <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnRgb_ValueChanged"/>
            <TextBlock x:Name="BlueValue" Grid.Column="2" Text="0" TextAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- ============ HEX ============ -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{loc:Loc ColorPicker.HexLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="HexBox" Width="110" Padding="4,3" TextChanged="OnHex_TextChanged"/>
        </StackPanel>
    </Grid>
</UserControl>