<Window x:Class="Configuration_Management.DetectConfigurationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        Title="{loc:Loc DetectConfigs.Title}"
        Icon="{StaticResource AppIcon}"
        Width="760" Height="560"
        MinHeight="440" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Кнопки «Отметить все / Снять все / Инвертировать»: без рамки, с подсветкой при наведении -->
        <Style x:Key="SelectAllButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Text="{loc:Loc DetectConfigs.TitleHeader}"/>
        <TextBlock Grid.Row="1" FontSize="12" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="{loc:Loc DetectConfigs.Subtitle}"/>

        <!-- Таблица баз -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1"
                        Padding="8,4" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CheckAllButton" Style="{StaticResource SelectAllButtonStyle}"
                                ToolTip="{loc:Loc DetectConfigs.Button.CheckAllTooltip}"
                                Click="OnCheckAllClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMultipleMarked" Width="16" Height="16"
                                                         Foreground="#16A34A" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc DetectConfigs.Button.CheckAll}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" x:Name="UncheckAllButton"
                                Style="{StaticResource SelectAllButtonStyle}"
                                Margin="16,0,0,0" ToolTip="{loc:Loc DetectConfigs.Button.UncheckAllTooltip}"
                                Click="OnUncheckAllClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMultipleBlankOutline" Width="16" Height="16"
                                                         Foreground="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc DetectConfigs.Button.UncheckAll}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="InvertButton"
                                Style="{StaticResource SelectAllButtonStyle}"
                                Margin="16,0,0,0" ToolTip="{loc:Loc DetectConfigs.Button.InvertTooltip}"
                                Click="OnInvertClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SelectInverse" Width="16" Height="16"
                                                         Foreground="#8B5CF6" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc DetectConfigs.Button.Invert}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Действие при ошибке (issue #236, п.2) -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc DetectConfigs.ErrorMode}" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ErrorModeCombo" MinWidth="180" Height="28" VerticalAlignment="Center"
                                      SelectionChanged="OnErrorModeSelectionChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid x:Name="BasesGrid" AutoGenerateColumns="False" IsReadOnly="False"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" RowHeaderWidth="0" SelectionMode="Single"
                          BorderThickness="0" Background="Transparent" GridLinesVisibility="None"
                          RowHeight="32" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}">
                    <DataGrid.Columns>
                        <!-- Флажок через шаблонную колонку с CheckBox: срабатывает с первого клика,
                             без предварительного фокуса (issue #236, п.3). -->
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.Header>
                                <TextBlock x:Name="CheckedHeaderText" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc DetectConfigs.Column.CheckedHeaderFormat}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Колонка платформы (issue #236, п.4) -->
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc DetectConfigs.Column.Platform}"
                                            Binding="{Binding PlatformVersion}" IsReadOnly="True"/>

                        <DataGridTextColumn Width="*" Header="{loc:Loc DetectConfigs.Column.Name}"
                                            Binding="{Binding Name}" IsReadOnly="True"/>
                        <DataGridTextColumn Width="*" Header="{loc:Loc DetectConfigs.Column.CurrentConfig}"
                                            Binding="{Binding ConfigurationName}" IsReadOnly="True"/>
                        <DataGridTextColumn Width="*" Header="{loc:Loc DetectConfigs.Column.Version}"
                                            Binding="{Binding ConfigurationVersion}" IsReadOnly="True"/>

                        <!-- Индикатор заполненности логина/пароля (issue #236, п.5) -->
                        <DataGridTemplateColumn Width="40" Header="{loc:Loc DetectConfigs.Column.Credentials}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="●" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               ToolTip="{loc:Loc DetectConfigs.CredentialsMissingTooltip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCredentials}" Value="True">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                        <Setter Property="ToolTip"
                                                                Value="{loc:Loc DetectConfigs.CredentialsFilledTooltip}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Кнопка свойств базы под курсором (issue #236, п.5) -->
                        <DataGridTemplateColumn Width="40" Header="{loc:Loc DetectConfigs.Column.Properties}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="OnPropertiesClick" Cursor="Hand" Background="Transparent"
                                            BorderThickness="0" Style="{StaticResource SelectAllButtonStyle}"
                                            ToolTip="{loc:Loc DetectConfigs.Button.PropertiesTooltip}">
                                        <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16"
                                                                 Foreground="#8B5CF6"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Нижняя панель: кнопки Определить / Закрыть -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Текущая база (п.1) и результат обработки предыдущей (п.1/п.2) -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="ProgressText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SummaryText" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StopButton" Width="120" Height="36" Margin="0,0,10,0" IsEnabled="False"
                        Click="OnStop_Click" Cursor="Hand" Background="#EF4444" BorderThickness="0"
                        ToolTip="{loc:Loc DetectConfigs.Button.StopTooltip}" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StopCircleOutline" Width="16" Height="16" Foreground="White"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc DetectConfigs.Button.Stop}" VerticalAlignment="Center"
                                   Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DetectButton" Width="180" Height="36" Margin="0,0,10,0" IsDefault="True"
                        Click="OnDetect_Click"
                        Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#166534"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MagnifyScan" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc DetectConfigs.Button.Detect}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Width="140" Height="36" IsCancel="True"
                        Background="Transparent" Cursor="Hand" BorderThickness="1.5"
                        BorderBrush="#EF4444" Foreground="#EF4444" Click="OnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>