<!-- Диалог ввода названия тега (Avalonia/Linux). Разметка повторяет
     Views/TagInputWindow.xaml Windows-версии; поведение и кнопки остаются
     в коде за разметкой, в TagInputWindow.Avalonia.cs. -->
<local:ModalWindowBase xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:Configuration_Management"
                       xmlns:loc="clr-namespace:Configuration_Management.Localization"
                       x:Class="Configuration_Management.TagInputWindow"
                       Title="{loc:Loc TagInput.Title}"
                       Width="420"
                       SizeToContent="Height"
                       CanResize="False"
                       SystemDecorations="None">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0"
                   Text="{loc:Loc TagInput.Prompt}"
                   Margin="0,0,0,8"/>
        <TextBox Grid.Row="1" x:Name="TagBox" Theme="{DynamicResource ModernTextBox}"/>
        <!-- Отступ панели кнопок сверху взят из разметки WPF. -->
        <ContentControl Grid.Row="2" x:Name="ButtonsHost" Margin="0,16,0,0"/>
    </Grid>
</local:ModalWindowBase>
