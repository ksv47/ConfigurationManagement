<Window x:Class="Configuration_Management.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Profiles.Title}"
        Icon="{StaticResource AppIcon}"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="640"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <!-- РќР•Р›Р¬Р—РЇ BasedOn="{StaticResource ModernTextBox}" РґР»СЏ PasswordBox: ModernTextBox РёРјРµРµС‚
             TargetType="TextBox", Р° BasedOn С‚СЂРµР±СѓРµС‚ СЃРѕРІРјРµСЃС‚РёРјРѕСЃС‚Рё С‚РёРїРѕРІ (TextBox РЅРµ СЏРІР»СЏРµС‚СЃСЏ
             Р±Р°Р·РѕРІС‹Рј РґР»СЏ PasswordBox). РР·-Р·Р° СЌС‚РѕРіРѕ WPF РїР°РґР°Р» СЃ XamlParseException РїСЂРё СЃРѕР·РґР°РЅРёРё
             РїРµСЂРІРѕРіРѕ PasswordBox (СЃС‚СЂРѕРєР° В«РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ PasswordBox РІС‹Р·РІР°Р»Р° РёСЃРєР»СЋС‡РµРЅРёРµВ»).
             PasswordBox Рё С‚Р°Рє РїРѕР»СѓС‡РёС‚ С‚РµРјРёСЂРѕРІР°РЅРЅС‹Р№ implicit-СЃС‚РёР»СЊ РёР· LightTheme/DarkTheme,
             РєР°Рє РІ LoginWindow Рё ConnectionSettingsWindow. -->
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Подсказка и активная учётная запись ============ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc Profiles.Hint}" TextWrapping="Wrap" Opacity="0.85"/>
            <TextBlock Text="{Binding CurrentAccountLabel}" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ============ Выпадающее меню активной учётной записи ============ -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc Profiles.ActiveAccount}"
                       VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding CurrentProfile, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- ============ Список + редактор ============ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: список учётных записей с бейджем «активная» -->
            <ListBox Grid.Column="0" Margin="0,0,12,0"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Profiles.Active}" Margin="8,0,0,0"
                                       Foreground="#2E7D32" FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Правая колонка: панель редактирования выбранной записи -->
            <Border Grid.Column="1" Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource ItemHoverBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding EditingTitle}" FontWeight="SemiBold" FontSize="15"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Приглашение, когда запись не выбрана -->
                    <TextBlock Text="{loc:Loc Profiles.SelectToEdit}" TextWrapping="Wrap" Opacity="0.8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Поля редактирования -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Profiles.Name}" VerticalAlignment="Center" Margin="0,0,8,0" Width="100"/>
                            <TextBox x:Name="NameBox" Width="260" Padding="8,6"
                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Profiles.Password}" VerticalAlignment="Center" Margin="0,0,8,0" Width="100"/>
                            <PasswordBox x:Name="PasswordInput" Width="260" Padding="8,6" PasswordChanged="OnPassword_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="ProtectCheck" Content="{loc:Loc Profiles.ProtectWithPassword}" Margin="108,0,0,0"
                                  IsChecked="{Binding ProtectWithPassword}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Ошибка ============ -->
        <TextBlock Grid.Row="3" x:Name="ErrorLabel" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding ErrorMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#E53935"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- ============ Кнопки ============ -->
        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Left" Width="110" Padding="12,6"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Click="OnCancel_Click">
                <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="120" Margin="0,0,8,0"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding DeleteCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="рџ—‘" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Profiles.Delete}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="150" Margin="0,0,8,0"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding ActivateCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="в…" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Profiles.Activate}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="130" Margin="0,0,8,0"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="вњ”" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Profiles.Save}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="130"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding CreateCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="пј‹" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Profiles.Create}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
