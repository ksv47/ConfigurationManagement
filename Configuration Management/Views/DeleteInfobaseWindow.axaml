<!-- Диалог удаления информационной базы (Avalonia/Linux). Раскладка повторяет
     Views/DeleteInfobaseWindow.xaml Windows-версии: заголовок, карточка со
     сведениями «подпись - значение», блок физического удаления и кнопки.
     Значения полей и состояние блока заполняет код за разметкой. -->
<local:ModalWindowBase xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:Configuration_Management"
                       xmlns:loc="clr-namespace:Configuration_Management.Localization"
                       x:Class="Configuration_Management.DeleteInfobaseWindow"
                       Title="{loc:Loc DeleteInfobase.Title}"
                       Width="520"
                       SizeToContent="Height"
                       CanResize="False"
                       SystemDecorations="Full">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto">

        <TextBlock Grid.Row="0"
                   Text="{loc:Loc DeleteInfobase.Title}"
                   FontSize="15" FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="12,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc DeleteInfobase.DetailName}"
                           FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NameText"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Main.Type}"
                           FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TypeText"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Main.ServerPath}"
                           FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PathText"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Main.GroupLabel}"
                           FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="GroupText"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Main.Platform}"
                           FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PlatformText"
                           FontSize="12" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" x:Name="PhysicalPanel" Spacing="6" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc DeleteInfobase.PhysicalHeader}" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{loc:Loc DeleteInfobase.DirLabel}"/>
                <TextBlock x:Name="ExistsText"/>
            </StackPanel>
            <CheckBox x:Name="PhysicalCheck" Content="{loc:Loc DeleteInfobase.PhysicalDelete}"/>
            <TextBlock x:Name="PhysicalHint" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="{loc:Loc Common.Cancel}" MinWidth="100" IsCancel="True"/>
            <Button x:Name="DeleteButton" MinWidth="120" IsDefault="True"
                    Background="#DC2626" Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{DynamicResource IconDelete}" Width="16" Height="16"
                          Stretch="Uniform" Fill="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc DeleteInfobase.Delete}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</local:ModalWindowBase>
