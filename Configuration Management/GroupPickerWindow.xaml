<Window x:Class="Configuration_Management.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Configuration_Management.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Выбор группы"
        Icon="{StaticResource AppIcon}"
        Width="480" Height="520"
        MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Выберите группу в дереве. Двойной щелчок — подтверждение. «Без группы» — корневой уровень."/>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="4">
            <TreeView x:Name="GroupsTree"
                      Background="Transparent"
                      BorderThickness="0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectedItemChanged="OnGroupsTree_SelectedItemChanged"
                      MouseDoubleClick="OnGroupsTree_MouseDoubleClick">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:GroupNodeViewModel}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <materialDesign:PackIcon Kind="Folder" Width="16" Height="16"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SelectButton" Width="120" Height="34" Style="{DynamicResource ModernButton}"
                    Margin="0,0,10,0" IsDefault="True" Click="OnSelect_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Выбрать" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="34" Style="{DynamicResource SecondaryButton}" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
