<Window x:Class="Configuration_Management.GroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Настройка группы"
        Icon="{StaticResource AppIcon}"
        Width="500"
        MinWidth="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="PaletteColorButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Тёмный фон — белые и цветные иконки всегда читаются -->
        <Style x:Key="IconPickButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4B5563"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Основные параметры" Padding="10" Margin="0,0,0,12"
                  BorderBrush="{DynamicResource BorderBrushColor}"
                  Background="{DynamicResource CardBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center" Margin="0,4"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="4,3"
                         Style="{DynamicResource ModernTextBox}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Родительская группа:" VerticalAlignment="Center" Margin="0,4"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ParentPathBox" Grid.Column="0" IsReadOnly="True" Padding="4,3"
                             Style="{DynamicResource ModernTextBox}"
                             VerticalContentAlignment="Center"
                             ToolTip="Группа, внутри которой будет находиться данная группа"/>
                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,4"
                            Style="{DynamicResource SecondaryButton}"
                            Click="OnSelectParent_Click" ToolTip="Выбрать родительскую группу в дереве">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Выбрать…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание:" VerticalAlignment="Center" Margin="0,4"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="DescriptionBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="4,3"
                         Style="{DynamicResource ModernTextBox}"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Цвет заголовка" Padding="10" Margin="0,0,0,12"
                  BorderBrush="{DynamicResource BorderBrushColor}"
                  Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="Фон строки группы в списке баз."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border x:Name="ColorPreview" Width="48" Height="32" CornerRadius="4" Margin="0,0,10,0"
                            VerticalAlignment="Center" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"/>
                    <TextBlock x:Name="ColorHexText" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontFamily="Consolas"/>
                    <Button Margin="16,0,0,0" Padding="10,4" Style="{DynamicResource SecondaryButton}"
                            Click="OnPickHeaderColor_Click" ToolTip="Полная палитра для цвета заголовка">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Palette" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Палитра…" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="Быстрый выбор:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                <UniformGrid x:Name="HeaderPaletteGrid" Rows="2" Columns="8">
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#EF4444" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#F97316" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#F59E0B" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#EAB308" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#84CC16" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#22C55E" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#10B981" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#14B8A6" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#06B6D4" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#0EA5E9" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#3B82F6" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#2D6CDF" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#6366F1" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#8B5CF6" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#A855F7" Click="OnHeaderPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#D946EF" Click="OnHeaderPalette_Click"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Иконка и её цвет" Padding="10" Margin="0,0,0,12"
                  BorderBrush="{DynamicResource BorderBrushColor}"
                  Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="Цвет только для иконки (независим от фона заголовка)."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border x:Name="IconColorPreview" Width="48" Height="32" CornerRadius="4" Margin="0,0,10,0"
                            VerticalAlignment="Center" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"/>
                    <TextBlock x:Name="IconColorHexText" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontFamily="Consolas"/>
                    <Button Margin="16,0,0,0" Padding="10,4" Style="{DynamicResource SecondaryButton}"
                            Click="OnPickIconColor_Click" ToolTip="Полная палитра для цвета иконки">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Palette" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Палитра…" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="Быстрый выбор цвета иконки:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                <UniformGrid x:Name="IconPaletteGrid" Rows="2" Columns="8" Margin="0,0,0,12">
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#EF4444" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#F97316" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#F59E0B" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#EAB308" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#84CC16" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#22C55E" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#10B981" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#14B8A6" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#06B6D4" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#0EA5E9" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#3B82F6" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#2D6CDF" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#6366F1" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#8B5CF6" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#A855F7" Click="OnIconPalette_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#D946EF" Click="OnIconPalette_Click"/>
                </UniformGrid>
                <TextBlock Text="Иконка:"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                <WrapPanel x:Name="IconPickerPanel"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Width="130" Height="36" Style="{DynamicResource ModernButton}"
                    Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSave}" Fill="White" Width="16" Height="16"
                          Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="36" Style="{DynamicResource SecondaryButton}" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconClear}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14"
                          Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
