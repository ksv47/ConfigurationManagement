<Window x:Class="Configuration_Management.LaunchParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Конфигуратор параметров запуска"
        Icon="{StaticResource AppIcon}"
        Width="800"
        Height="680"
        MinWidth="720"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Параметры-флаги -->
        <GroupBox Grid.Row="0" Header="Параметры-флаги" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <CheckBox x:Name="ChkDisableStartupMessages" Margin="0,4">
                        <TextBlock Text="/DisableStartupMessages — отключить сообщения при запуске" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkDisableStartupDialogs" Margin="0,4">
                        <TextBlock Text="/DisableStartupDialogs — отключить диалоги при запуске" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkDisableSplash" Margin="0,4">
                        <TextBlock Text="/DisableSplash — отключить заставку" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkWait" Margin="0,4">
                        <TextBlock Text="/WA- — не ждать завершения" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkDebug" Margin="0,4">
                        <TextBlock Text="/Debug — режим отладки" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <CheckBox x:Name="ChkAllowScheduledJobs" Margin="0,4">
                        <TextBlock Text="/AllowExecuteScheduledJobs — регламентные задания" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkRunManaged" Margin="0,4">
                        <TextBlock Text="/RunModeManagedApplication — тонкий клиент" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkRunOrdinary" Margin="0,4">
                        <TextBlock Text="/RunModeOrdinaryApplication — толстый клиент" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkUpdateCfg" Margin="0,4">
                        <TextBlock Text="/UpdateCfg — обновление конфигурации" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkTestServer" Margin="0,4">
                        <TextBlock Text="/TestServer — тестирование сервера" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ============ Параметры с аргументами -->
        <GroupBox Grid.Row="1" Header="Параметры с аргументами" Padding="12" Margin="0,0,0,12">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Margin="0,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamCheckBox"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkUC" Content="/UC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtUC" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Код разрешения запуска"/>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1" Margin="12,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamCheckBox"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkLang" Content="/L" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtLang" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Язык интерфейса (например, ru)"/>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamCheckBox"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkOut" Content="/Out" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtOut" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Путь к файлу вывода служебных сообщений"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" Margin="12,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamCheckBox"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkC" Content="/C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtC" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Строка параметров запуска"/>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="0" Margin="0,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamCheckBox"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkExecute" Content="/Execute" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtExecute" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Путь к внешней обработке для выполнения"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" Margin="12,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamCheckBox"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkDumpResult" Content="/DumpResult" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtDumpResult" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Путь к файлу выгрузки результата"/>
                </Grid>

                <Grid Grid.Row="3" Grid.Column="0" Margin="0,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamCheckBox"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkUser" Content="/N" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtUser" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Имя пользователя"/>
                </Grid>
                <Grid Grid.Row="3" Grid.Column="1" Margin="12,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamCheckBox"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkPwd" Content="/P" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtPwd" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Пароль пользователя"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ============ Произвольные параметры -->
        <GroupBox Grid.Row="2" Header="Произвольные параметры" Padding="12" Margin="0,0,0,12">
            <TextBox x:Name="TxtCustom" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"
                     Padding="6,4" VerticalScrollBarVisibility="Auto"
                     ToolTip="Дополнительные параметры командной строки 1С"/>
        </GroupBox>

        <!-- ============ Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="140" Height="36" Margin="0,0,10,0" IsDefault="True" Click="OnOk_Click"
                    Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ОК" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Width="140" Height="36" IsCancel="True"
                    Background="Transparent" Cursor="Hand" BorderThickness="1.5"
                    BorderBrush="#EF4444" Foreground="#EF4444">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</Window>