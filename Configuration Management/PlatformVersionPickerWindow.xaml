<Window x:Class="Configuration_Management.PlatformVersionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:Configuration_Management.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc PlatformVersionPicker.Title}"
        Icon="{StaticResource AppIcon}"
        Width="520" Height="560"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="ArchRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SortToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фильтр разрядности + сортировка (как в стартере 1С) -->
        <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="FilterAll" Content="{loc:Loc Common.All}" Style="{StaticResource ArchRadio}"
                                 GroupName="ArchFilter" IsChecked="True"
                                 Checked="OnArchFilter_Changed"/>
                    <RadioButton x:Name="FilterX32" Content="x32" Style="{StaticResource ArchRadio}"
                                 GroupName="ArchFilter"
                                 Checked="OnArchFilter_Changed"/>
                    <RadioButton x:Name="FilterX64" Content="x64" Style="{StaticResource ArchRadio}"
                                 GroupName="ArchFilter"
                                 Checked="OnArchFilter_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="SortAsc" Style="{StaticResource SortToggle}"
                                  ToolTip="{loc:Loc PlatformVersionPicker.SortAscTooltip}"
                                  Click="OnSortAsc_Click">
                        <materialDesign:PackIcon Kind="SortAscending" Width="16" Height="16"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SortDesc" Style="{StaticResource SortToggle}"
                                  IsChecked="True" ToolTip="{loc:Loc PlatformVersionPicker.SortDescTooltip}"
                                  Click="OnSortDesc_Click">
                        <materialDesign:PackIcon Kind="SortDescending" Width="16" Height="16"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Дерево: 8.3 → 8.3.27 → 8.3.27.2214 (x64) -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <TreeView x:Name="PlatformsTree"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="4"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectedItemChanged="OnPlatformsTree_SelectedItemChanged"
                      MouseDoubleClick="OnPlatformsTree_MouseDoubleClick">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type models:PlatformVersionGroup}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <!-- Иконка по типу узла: папка линии / папка сборок / куб x64|x32 -->
                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0"
                                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="Folder"/>
                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                        <Style.Triggers>
                                            <!-- Линия 8.3 — папка-акцент -->
                                            <DataTrigger Binding="{Binding Kind}" Value="Line">
                                                <Setter Property="Kind" Value="Folder"/>
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                            </DataTrigger>
                                            <!-- Группа сборок 8.3.27 — открытая папка -->
                                            <DataTrigger Binding="{Binding Kind}" Value="BuildGroup">
                                                <Setter Property="Kind" Value="FolderOpen"/>
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                            <!-- Сборка x64 -->
                                            <DataTrigger Binding="{Binding Kind}" Value="LeafX64">
                                                <Setter Property="Kind" Value="CubeOutline"/>
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                            </DataTrigger>
                                            <!-- Сборка x32 -->
                                            <DataTrigger Binding="{Binding Kind}" Value="LeafX32">
                                                <Setter Property="Kind" Value="Cube"/>
                                                <Setter Property="Foreground" Value="#8B5CF6"/>
                                            </DataTrigger>
                                            <!-- Сборка без метки разрядности -->
                                            <DataTrigger Binding="{Binding Kind}" Value="Leaf">
                                                <Setter Property="Kind" Value="Application"/>
                                                <Setter Property="Foreground" Value="#0EA5E9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{Binding Name}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SelectButton" Width="140" Height="36" Margin="0,0,10,0" IsDefault="True"
                    Click="OnSelect_Click" IsEnabled="False"
                    Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Select}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Width="140" Height="36" IsCancel="True"
                    Background="Transparent" Cursor="Hand" BorderThickness="1.5"
                    BorderBrush="#EF4444" Foreground="#EF4444">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
