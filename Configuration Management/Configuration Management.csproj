<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- AssemblyName без пробела: иначе при single-file publish WPF не находит
         ресурс «app.xaml» (System.IO.IOException при запуске). -->
    <AssemblyName>ConfigurationManagement</AssemblyName>
    <RootNamespace>Configuration_Management</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>Управление конфигурациями 1С</AssemblyTitle>
    <Product>Управление конфигурациями 1С</Product>
    <!-- Примечание: .NET/NuGet поддерживают не более 4 числовых частей версии,
         поэтому AssemblyVersion/FileVersion/Version ограничены 4 частями, а точная
         пользовательская версия «0.2.7.13» задаётся через InformationalVersion
         и выводится в заголовок окна. -->
    <Version>0.2.7</Version>
    <AssemblyVersion>0.2.7</AssemblyVersion>
    <FileVersion>0.2.7</FileVersion>
    <InformationalVersion>0.2.7.31</InformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- RID/SelfContained только при publish, чтобы обычный dotnet run/build не ломался -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF pack URI + embedded для single-file трея (без копирования рядом с exe,
         чтобы в результате публикации был только один файл) -->
    <Resource Include="app.ico" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <Resource Include="tray.ico" />
    <EmbeddedResource Include="tray.ico" LogicalName="tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <!-- Для чтения командной строки процессов 1cv8.exe (Win32_Process) при проверке
         блокировки запуска конфигуратора перед выгрузкой .dt / .cf. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Не импортировать WinForms/Drawing глобально — иначе конфликт с типами WPF -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
