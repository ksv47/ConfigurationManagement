<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Configuration_Management</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>Управление конфигурациями 1С</AssemblyTitle>
    <Product>Управление конфигурациями 1С</Product>
    <Version>0.2.6.18</Version>
    <AssemblyVersion>0.2.6.18</AssemblyVersion>
    <FileVersion>0.2.6.18</FileVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- RID/SelfContained только при publish, чтобы обычный dotnet run/build не ломался -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF pack URI + embedded для single-file трея (без копирования рядом с exe,
         чтобы в результате публикации был только один файл) -->
    <Resource Include="app.ico" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <Resource Include="tray.ico" />
    <EmbeddedResource Include="tray.ico" LogicalName="tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
  </ItemGroup>

  <!-- Не импортировать WinForms/Drawing глобально — иначе конфликт с типами WPF -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
